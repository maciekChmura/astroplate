{
  "site": {
    "title": "AIBrandScan",
    "base_url": "https://aibrandscan.com",
    "base_path": "/",
    "trailing_slash": true,
    "favicon": "/sites/aibrandscan/images/favicon.png",
    "logo_layout": "text",
    "logo": "/sites/aibrandscan/images/logo.svg",
    "logo_darkmode": "/sites/aibrandscan/images/logo.svg",
    "logo_url": "https://aibrandscan.com",
    "logo_width": "36",
    "logo_height": "36",
    "logo_text": "AIBrandScan"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "default_language": "en",
    "disable_languages": [],
    "default_language_in_subdir": false,
    "knowledge_hub_content_deploy": false,
    "pagination": 6,
    "summary_length": 200
  },

  "announcement": {
    "enable": false,
    "content": "<span class='text-center block'>Explore AIBrandScan resources for AI search visibility and brand monitoring.</span>",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "Designed And Developed by AIBrandScan"
  },

  "navigation_button": {
    "enable": false,
    "label": "Scan your brand",
    "link": "https://aibrandscan.com"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "AIBrandScan",
    "default_author": "jowita-chmura",
    "meta_image": "/sites/aibrandscan/images/og-image.png",
    "meta_description": "Monitor how AI assistants mention, describe, compare, and recommend your brand."
  },

  "language_switcher": {
    "links": []
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
