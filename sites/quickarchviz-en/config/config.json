{
  "site": {
    "title": "QuickArchViz",
    "base_url": "https://quickarchviz.com",
    "base_path": "/",
    "trailing_slash": true,
    "favicon": "/sites/quickarchviz/images/favicon.png",
    "logo_layout": "lockup",
    "logo": "/sites/quickarchviz/images/q-logo.svg",
    "logo_darkmode": "/sites/quickarchviz/images/q-logo.svg",
    "logo_url": "https://quickarchviz.com",
    "logo_width": "36",
    "logo_height": "36",
    "logo_text": "QuickArchViz"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "default_language": "en",
    "disable_languages": [],
    "default_language_in_subdir": false,
    "pagination": 6,
    "summary_length": 200
  },

  "announcement": {
    "enable": false,
    "content": "<span class='text-center block'>Explore new QuickArchViz architecture AI resources in the Knowledge Hub.</span>",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "Designed And Developed by QuickArchViz"
  },

  "navigation_button": {
    "enable": false,
    "label": "Create visualization",
    "link": "https://quickarchviz.com/register"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "QuickArchViz",
    "default_author": "jowita-chmura",
    "meta_image": "/sites/quickarchviz/images/og-image.png",
    "meta_description": "QuickArchViz English resources"
  },

  "language_switcher": {
    "links": []
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
