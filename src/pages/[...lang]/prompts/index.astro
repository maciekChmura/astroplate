---
import PromptCard from "@/components/PromptCard.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { PROMPTS_CONTENT_FOLDER } from "@/lib/utils/promptRoutes";
import { humanize, slugify } from "@/lib/utils/textConverter";
import { normalizeLang, supportedLang } from "@/lib/utils/languageParser";
import PageHeader from "@/partials/PageHeader.astro";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
}

const lang = normalizeLang(Astro.params.lang);
const promptIndex = await getListPage(PROMPTS_CONTENT_FOLDER, lang, "-index");

if (promptIndex.data.draft) {
  return Astro.redirect("/404");
}

const prompts = await getSinglePage(PROMPTS_CONTENT_FOLDER, lang);
const promptGroups = prompts.reduce((groups, prompt) => {
  const category = prompt.data.categories[0] || "General";
  const key = slugify(category);

  if (!groups.has(key)) {
    groups.set(key, { title: category, prompts: [] });
  }

  groups.get(key)!.prompts.push(prompt);
  return groups;
}, new Map<string, { title: string; prompts: typeof prompts }>());
---

<Base
  title={promptIndex.data.title}
  description={promptIndex.data.description}
  image={promptIndex.data.image}
  lang={lang}
>
  <PageHeader title={promptIndex.data.title} />
  <section class="section-sm pb-0">
    <div class="container">
      {
        Array.from(promptGroups.values()).map((group) => (
          <div class="mb-16">
            <h2 class="h3 mb-8 text-center">{humanize(group.title)}</h2>
            <div class="row justify-center">
              {group.prompts.map((prompt) => (
                <div class="mb-14 md:col-6 lg:col-4">
                  <PromptCard data={prompt} />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Base>
