---
import PromptCard from "@/components/PromptCard.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { siteConfig } from "@/lib/siteConfig";
import { PROMPTS_CONTENT_FOLDER } from "@/lib/utils/promptRoutes";
import { normalizeLang, supportedLang } from "@/lib/utils/languageParser";
import PageHeader from "@/partials/PageHeader.astro";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
}

const lang = normalizeLang(Astro.params.lang);

if (siteConfig.site.title === "AIBrandScan") {
  return Astro.redirect("/prompt-library/", 301);
}

const promptIndex = await getListPage(PROMPTS_CONTENT_FOLDER, lang, "-index");

if (promptIndex.data.draft) {
  return Astro.redirect("/404");
}

const prompts = await getSinglePage(PROMPTS_CONTENT_FOLDER, lang);
---

<Base
  title={promptIndex.data.title}
  description={promptIndex.data.description}
  image={promptIndex.data.image}
  lang={lang}
>
  <PageHeader title={promptIndex.data.title} />
  <section class="section-sm pb-0">
    <div class="container">
      <div class="row justify-center">
        {
          prompts.map((prompt) => (
            <div class="mb-14 md:col-6 lg:col-4">
              <PromptCard data={prompt} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
