---
import Base from "@/layouts/Base.astro";
import UseCaseSingle from "@/layouts/UseCaseSingle.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { siteConfig } from "@/lib/siteConfig";
import { getAuthorProfile } from "@/lib/utils/authors";
import {
  normalizeLang,
  stripLocaleFromId,
  supportedLang,
} from "@/lib/utils/languageParser";
import {
  USE_CASES_CONTENT_FOLDER,
  useCasePath,
  useCasesIndexPath,
} from "@/lib/utils/useCaseRoutes";
import { withSiteMountPath } from "@/lib/utils/mountPath";
import { plainify } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const paths = [];

  for (const routeLang of supportedLang) {
    const lang = normalizeLang(routeLang);
    const useCases = await getSinglePage(USE_CASES_CONTENT_FOLDER, lang);

    paths.push(
      ...useCases.map((useCaseEntry) => ({
        params: {
          lang: routeLang || undefined,
          single: stripLocaleFromId(useCaseEntry.id),
        },
        props: { useCaseEntry, lang },
      })),
    );
  }

  return paths;
}

const { useCaseEntry, lang } = Astro.props;
const {
  title,
  meta_title,
  description,
  image,
  categories,
  tags,
  software,
  workflow,
  rendering_intent,
  input_example,
  style_selection,
  result,
  video,
  hero_before,
  hero_after,
  examples,
  faq,
} = useCaseEntry.data;
const useCaseSlug = stripLocaleFromId(useCaseEntry.id);
const plainDescription = plainify(description);
const canonicalPath = useCasePath(useCaseSlug, lang);
const siteUrl =
  Astro.site ||
  (siteConfig.site.base_url ? new URL(siteConfig.site.base_url) : undefined);
const canonicalUrl = siteUrl
  ? new URL(canonicalPath, siteUrl).toString()
  : canonicalPath;
const indexUrl = siteUrl
  ? new URL(useCasesIndexPath(lang), siteUrl).toString()
  : useCasesIndexPath(lang);
const primaryImage = image || hero_after?.src || hero_before?.src;
const imageUrl =
  siteUrl && primaryImage
    ? new URL(withSiteMountPath(primaryImage), siteUrl).toString()
    : primaryImage;
const imageUrls = [
  imageUrl,
  input_example?.image?.src && siteUrl
    ? new URL(withSiteMountPath(input_example.image.src), siteUrl).toString()
    : input_example?.image?.src,
  result?.image?.src && siteUrl
    ? new URL(withSiteMountPath(result.image.src), siteUrl).toString()
    : result?.image?.src,
  style_selection?.image?.src && siteUrl
    ? new URL(withSiteMountPath(style_selection.image.src), siteUrl).toString()
    : style_selection?.image?.src,
  ...(style_selection?.styles || [])
    .map((style) => style.image?.src)
    .filter(Boolean)
    .map((src) =>
      siteUrl ? new URL(withSiteMountPath(src!), siteUrl).toString() : src!,
    ),
  hero_before?.src && siteUrl
    ? new URL(withSiteMountPath(hero_before.src), siteUrl).toString()
    : hero_before?.src,
  hero_after?.src && siteUrl
    ? new URL(withSiteMountPath(hero_after.src), siteUrl).toString()
    : hero_after?.src,
  ...examples.flatMap((example) =>
    [example.image?.src, example.before?.src, example.after?.src]
      .filter(Boolean)
      .map((src) =>
        siteUrl ? new URL(withSiteMountPath(src!), siteUrl).toString() : src!,
      ),
  ),
].filter(Boolean);
const author = await getAuthorProfile({
  lang,
  authorSlug: useCaseEntry.data.author,
  siteUrl,
});
const useCaseJsonLd = [
  author.personJsonLd,
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    headline: title,
    description: plainDescription,
    image: imageUrls,
    inLanguage: lang,
    about: [
      "AI architectural visualization",
      software,
      workflow,
      rendering_intent,
      ...categories,
    ].filter(Boolean),
    keywords: tags.join(", "),
    author: author.id ? { "@id": author.id } : author.personJsonLd,
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Use Cases",
        item: indexUrl,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: title,
        item: canonicalUrl,
      },
    ],
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${
      siteUrl ? new URL(withSiteMountPath("/"), siteUrl).toString() : "/"
    }#software`,
    name: "QuickArchViz",
    applicationCategory: "DesignApplication",
    operatingSystem: "Web",
    url: siteUrl ? new URL(withSiteMountPath("/"), siteUrl).toString() : "/",
    description: siteConfig.metadata.meta_description,
  },
  video?.embed_url
    ? {
        "@type": "VideoObject",
        "@id": `${canonicalUrl}#video`,
        name: video.title,
        description: plainify(video.caption || description),
        embedUrl: video.embed_url,
      }
    : undefined,
  faq.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${canonicalUrl}#faq`,
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: plainify(item.answer),
          },
        })),
      }
    : undefined,
].filter(Boolean);
---

<Base
  title={title}
  meta_title={meta_title}
  description={plainDescription}
  image={primaryImage}
  canonical={canonicalPath}
  lang={lang}
  jsonLd={useCaseJsonLd}
>
  <UseCaseSingle useCaseEntry={useCaseEntry} lang={lang} author={author} />
</Base>
