---
import BlogCard from "@/components/BlogCard.astro";
import ImageMod from "@/components/ImageMod.astro";
import PromptCard from "@/components/PromptCard.astro";
import Social from "@/components/Social.astro";
import UseCaseCard from "@/components/UseCaseCard.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import {
  cleanJsonLd,
  getAuthorDisplayItem,
  getAuthorProfile,
  hasAuthoredContent,
} from "@/lib/utils/authors";
import {
  getTranslations,
  normalizeLang,
  stripLocaleFromId,
  supportedLang,
} from "@/lib/utils/languageParser";
import { siteConfig } from "@/lib/siteConfig";
import { render } from "astro:content";

export async function getStaticPaths() {
  const COLLECTION_FOLDER = "authors";
  const paths = [];

  for (const routeLang of supportedLang) {
    const lang = normalizeLang(routeLang);
    const authors = await getSinglePage(COLLECTION_FOLDER, lang);

    paths.push(
      ...authors.map((author) => ({
        params: {
          lang: routeLang || undefined,
          single: stripLocaleFromId(author.id),
        },
        props: { author, lang },
      })),
    );
  }

  return paths;
}

const { author, lang } = Astro.props;
const { meta_title } = author.data;
const { Content } = await render(author);
const authorSlug = stripLocaleFromId(author.id);
const siteUrl =
  Astro.site ||
  (siteConfig.site.base_url ? new URL(siteConfig.site.base_url) : undefined);
const profile = await getAuthorProfile({
  lang,
  authorSlug,
  siteUrl,
});

const posts = await getSinglePage("blog", lang);
const prompts = await getSinglePage("prompts", lang);
const useCases = await getSinglePage("use-cases", lang);
const authoredPosts = posts.filter((post) =>
  hasAuthoredContent(post, authorSlug),
);
const authoredPrompts = prompts.filter((prompt) =>
  hasAuthoredContent(prompt, authorSlug),
);
const authoredUseCases = useCases.filter((useCaseEntry) =>
  hasAuthoredContent(useCaseEntry, authorSlug),
);
const translations = (await getTranslations(lang)) as Record<string, string>;
const authorLabels = {
  experience: translations.author_experience || "Experience",
  experienceSuffix:
    translations.author_experience_suffix ||
    "years in architecture visualization and design communication.",
  expertise: translations.author_expertise || "Expertise",
  education: translations.author_education || "Education",
  certificates: translations.author_certificates || "Certificates",
  achievements: translations.author_achievements || "Achievements",
  about: translations.author_about || "About me",
  articlesBy: translations.author_articles_by || "Articles by",
  promptsBy: translations.author_prompts_by || "Prompts by",
  useCasesBy: translations.author_use_cases_by || "Use cases by",
  contact: translations.author_contact || "Contact",
  sendMessage: translations.author_send_message || "Send message",
  orEmail: translations.author_or_email || "Or email",
};
const contactAction =
  profile.contact?.form_action || siteConfig.params.contact_form_action || "#";
const contactLabel =
  profile.contact?.form_label || `${authorLabels.contact} ${profile.name}`;
const profileJsonLd = cleanJsonLd([
  profile.personJsonLd,
  {
    "@type": "ProfilePage",
    "@id": profile.absoluteUrl ? `${profile.absoluteUrl}#profile` : undefined,
    url: profile.absoluteUrl || profile.url,
    name: profile.name,
    description: profile.description,
    inLanguage: lang,
    mainEntity: profile.id ? { "@id": profile.id } : profile.personJsonLd,
  },
]);
---

<Base
  title={profile.name}
  meta_title={meta_title}
  description={profile.description}
  image={profile.image}
  lang={lang}
  canonical={profile.url}
  jsonLd={profileJsonLd}
>
  <section class="section-sm pb-0">
    <div class="container">
      <div
        class="row items-start justify-center gap-y-10 border-b border-border pb-14 dark:border-darkmode-border"
      >
        <div class="text-center lg:col-4">
          {
            profile.image && (
              <ImageMod
                src={profile.image}
                class="mx-auto mb-8 rounded"
                height={200}
                width={200}
                alt={profile.name}
                format="webp"
              />
            )
          }
          <h1 class="h3 mb-3">{profile.name}</h1>
          {
            profile.jobTitle && (
              <p class="mb-4 font-medium">{profile.jobTitle}</p>
            )
          }
          {profile.statement && <p class="mb-6">{profile.statement}</p>}
          {
            profile.social && profile.social.length > 0 && (
              <Social source={profile.social} className="social-icons" />
            )
          }
        </div>

        <div class="lg:col-7">
          <div class="grid gap-6">
            {
              profile.yearsExperience && (
                <section>
                  <h2 class="h5 mb-3">{authorLabels.experience}</h2>
                  <p class="mb-0">
                    {profile.yearsExperience} {authorLabels.experienceSuffix}
                  </p>
                </section>
              )
            }
            {
              profile.expertise.length > 0 && (
                <section>
                  <h2 class="h5 mb-3">{authorLabels.expertise}</h2>
                  <ul class="mb-0 list-disc pl-5">
                    {profile.expertise.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>
              )
            }
            {
              profile.education.length > 0 && (
                <section>
                  <h2 class="h5 mb-3">{authorLabels.education}</h2>
                  <ul class="mb-0 list-disc pl-5">
                    {profile.education.map((item) => (
                      <li>{getAuthorDisplayItem(item)}</li>
                    ))}
                  </ul>
                </section>
              )
            }
            {
              profile.certificates.length > 0 && (
                <section>
                  <h2 class="h5 mb-3">{authorLabels.certificates}</h2>
                  <ul class="mb-0 list-disc pl-5">
                    {profile.certificates.map((item) => (
                      <li>{getAuthorDisplayItem(item)}</li>
                    ))}
                  </ul>
                </section>
              )
            }
          </div>

          {
            profile.achievements.length > 0 && (
              <section class="mt-8">
                <h2 class="h5 mb-3">{authorLabels.achievements}</h2>
                <ul class="mb-0 list-disc pl-5">
                  {profile.achievements.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            )
          }

          <section class="mt-8">
            <h2 class="h2 mb-3">{authorLabels.about}</h2>
            <div class="content">
              <Content />
            </div>
          </section>
        </div>
      </div>

      <section class="pb-8 pt-14">
        <h2 class="h3 mb-8 text-center">
          {authorLabels.articlesBy}
          {profile.name}
        </h2>
        <div class="row justify-center">
          {
            authoredPosts.map((post) => (
              <div class="mb-12 md:col-6 lg:col-4">
                <BlogCard data={post} />
              </div>
            ))
          }
        </div>
      </section>

      {
        authoredPrompts.length > 0 && (
          <section class="pb-8 pt-6">
            <h2 class="h3 mb-8 text-center">
              {authorLabels.promptsBy} {profile.name}
            </h2>
            <div class="row justify-center">
              {authoredPrompts.map((prompt) => (
                <div class="mb-12 md:col-6 lg:col-4">
                  <PromptCard data={prompt} />
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        authoredUseCases.length > 0 && (
          <section class="pb-8 pt-6">
            <h2 class="h3 mb-8 text-center">
              {authorLabels.useCasesBy} {profile.name}
            </h2>
            <div class="row justify-center">
              {authoredUseCases.map((useCaseEntry) => (
                <div class="mb-12 md:col-6 lg:col-4">
                  <UseCaseCard data={useCaseEntry} />
                </div>
              ))}
            </div>
          </section>
        )
      }

      <section class="pb-16 pt-6">
        <div class="mx-auto max-w-2xl">
          <h2 class="h3 mb-8 text-center">{contactLabel}</h2>
          <form action={contactAction} method="POST">
            <div class="mb-6">
              <label for="author-contact-name" class="form-label">
                {translations.full_name || "Full name"}{" "}
                <span class="text-red-500">*</span>
              </label>
              <input
                id="author-contact-name"
                name="name"
                class="form-input"
                type="text"
                required
              />
            </div>
            <div class="mb-6">
              <label for="author-contact-email" class="form-label">
                {translations.working_mail || "Email"}{" "}
                <span class="text-red-500">*</span>
              </label>
              <input
                id="author-contact-email"
                name="email"
                class="form-input"
                type="email"
                required
              />
            </div>
            <div class="mb-6">
              <label for="author-contact-message" class="form-label">
                {translations.message || "Message"}{" "}
                <span class="text-red-500">*</span>
              </label>
              <textarea
                id="author-contact-message"
                name="message"
                class="form-input"
                required
                rows="6"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">
              {authorLabels.sendMessage}
            </button>
          </form>
          {
            profile.contact?.email && (
              <p class="mt-5 text-center">
                {authorLabels.orEmail}{" "}
                <a href={`mailto:${profile.contact.email}`}>
                  {profile.contact.email}
                </a>
              </p>
            )
          }
        </div>
      </section>
    </div>
  </section>
</Base>
