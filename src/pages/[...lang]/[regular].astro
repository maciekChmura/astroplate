---
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import {
  normalizeLang,
  stripLocaleFromId,
  supportedLang,
} from "@/lib/utils/languageParser";
import PageHeader from "@/partials/PageHeader.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const paths = [];

  for (const routeLang of supportedLang) {
    const lang = normalizeLang(routeLang);
    const pages = await getSinglePage("pages", lang);

    paths.push(
      ...pages.map((page) => ({
        params: {
          lang: routeLang || undefined,
          regular: stripLocaleFromId(page.id),
        },
        props: { entry: page, lang },
      })),
    );
  }

  return paths;
}

const { entry, lang } = Astro.props;
const { title, description, image } = entry.data;
const metaTitle =
  "meta_title" in entry.data ? entry.data.meta_title : undefined;
const pageContent = await render(entry);
const Content = pageContent?.Content;
---

<Base
  title={title}
  meta_title={metaTitle}
  description={description}
  image={image}
  lang={lang}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <div class="content">{Content && <Content />}</div>
        </div>
      </div>
    </div>
  </section>
</Base>
