---
import Base from "@/layouts/Base.astro";
import PostSingle from "@/layouts/PostSingle.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { siteConfig } from "@/lib/siteConfig";
import { getAuthorProfile } from "@/lib/utils/authors";
import { blogPostPath, BLOG_CONTENT_FOLDER } from "@/lib/utils/blogRoutes";
import { assertAvailableBlogSlugs } from "@/lib/utils/blogSlugCollisions";
import {
  normalizeLang,
  stripLocaleFromId,
  supportedLang,
} from "@/lib/utils/languageParser";

export async function getStaticPaths() {
  const paths = [];

  for (const routeLang of supportedLang) {
    const lang = normalizeLang(routeLang);
    const posts = await getSinglePage(BLOG_CONTENT_FOLDER, lang);

    assertAvailableBlogSlugs(lang, posts);

    paths.push(
      ...posts.map((post) => ({
        params: {
          lang: routeLang || undefined,
          single: stripLocaleFromId(post.id),
        },
        props: { post, lang },
      })),
    );
  }

  return paths;
}

const { post, lang } = Astro.props;
const { title, description, image, categories, tags } = post.data;
const postSlug = stripLocaleFromId(post.id);
const postCanonicalPath = blogPostPath(postSlug, lang);
const siteUrl =
  Astro.site ||
  (siteConfig.site.base_url ? new URL(siteConfig.site.base_url) : undefined);
const siteRootUrl = siteUrl ? new URL("/", siteUrl).toString() : undefined;
const canonicalUrl =
  siteUrl && postCanonicalPath
    ? new URL(postCanonicalPath, siteUrl).toString()
    : postCanonicalPath;
const imageUrl = siteUrl && image ? new URL(image, siteUrl).toString() : image;
const organizationId = siteRootUrl ? `${siteRootUrl}#organization` : undefined;
const publishedDate =
  post.data.date instanceof Date ? post.data.date : new Date(post.data.date);
const author = await getAuthorProfile({
  lang,
  authorSlug: post.data.author,
  siteUrl,
});
const articleJsonLd = [
  author.personJsonLd,
  {
    "@type": "BlogPosting",
    "@id": `${canonicalUrl}#article`,
    headline: title,
    description,
    image: imageUrl,
    datePublished: publishedDate.toISOString(),
    dateModified: publishedDate.toISOString(),
    author: author.id ? { "@id": author.id } : author.personJsonLd,
    publisher: organizationId
      ? {
          "@id": organizationId,
        }
      : {
          "@type": "Organization",
          name: siteConfig.metadata.meta_author || siteConfig.site.title,
        },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
    url: canonicalUrl,
    articleSection: categories[0],
    keywords: tags.join(", "),
    inLanguage: lang,
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: siteConfig.site.title,
        item: siteRootUrl,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: title,
        item: canonicalUrl,
      },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  image={image}
  canonical={postCanonicalPath}
  og_type="article"
  lang={lang}
  jsonLd={articleJsonLd}
  articlePublishedTime={publishedDate}
  articleModifiedTime={publishedDate}
  articleSection={categories[0]}
  articleTags={tags}
  articleAuthor={author.absoluteUrl || author.name}
>
  <PostSingle post={post} author={author} />
</Base>
