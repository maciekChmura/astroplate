---
import BlogCard from "@/components/BlogCard.astro";
import Pagination from "@/components/Pagination.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { siteConfig } from "@/lib/siteConfig";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { BLOG_CONTENT_FOLDER } from "@/lib/utils/blogRoutes";
import { normalizeLang, supportedLang } from "@/lib/utils/languageParser";
import { sortByDate } from "@/lib/utils/sortFunctions";
import PageHeader from "@/partials/PageHeader.astro";
import PostSidebar from "@/partials/PostSidebar.astro";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
}

const lang = normalizeLang(Astro.params.lang);
const postIndex = await getListPage(BLOG_CONTENT_FOLDER, lang, "-index");
if (postIndex.data.draft) {
  return Astro.redirect("/404");
}
const posts = await getSinglePage(BLOG_CONTENT_FOLDER, lang);
const allCategories = await getAllTaxonomy(
  BLOG_CONTENT_FOLDER,
  lang,
  "categories",
);
const categories = await getTaxonomy(BLOG_CONTENT_FOLDER, lang, "categories");
const tags = await getTaxonomy(BLOG_CONTENT_FOLDER, lang, "tags");
const sortedPosts = sortByDate(posts);
const totalPages: number = Math.ceil(
  posts.length / siteConfig.settings.pagination,
);
const currentPosts = sortedPosts.slice(0, siteConfig.settings.pagination);
const archiveDescription =
  postIndex.data.description === "this is meta description"
    ? `Read the latest articles from ${siteConfig.site.title}, organized by topic and published in reverse chronological order.`
    : postIndex.data.description;
const archiveMetaTitle = `${postIndex.data.title} | ${siteConfig.site.title}`;
---

<Base
  title={postIndex.data.title}
  meta_title={archiveMetaTitle}
  image={postIndex.data.image}
  description={archiveDescription}
  lang={lang}
>
  <PageHeader title={postIndex?.data.title} />
  <section class="section">
    <div class="container">
      <div class="row gx-5">
        <div class="lg:col-8">
          <div class="row">
            {
              currentPosts.map((post) => (
                <div class="mb-14 md:col-6">
                  <BlogCard data={post} />
                </div>
              ))
            }
          </div>
          <Pagination section="blog" currentPage={1} totalPages={totalPages} />
        </div>

        <PostSidebar
          categories={categories}
          tags={tags}
          allCategories={allCategories}
        />
      </div>
    </div>
  </section>
</Base>
