---
import BlogCard from "@/components/BlogCard.astro";
import AIBrandScanArchiveHero from "@/components/AIBrandScanArchiveHero.astro";
import Pagination from "@/components/Pagination.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { siteConfig } from "@/lib/siteConfig";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { BLOG_CONTENT_FOLDER } from "@/lib/utils/blogRoutes";
import { normalizeLang, supportedLang } from "@/lib/utils/languageParser";
import { sortByDate } from "@/lib/utils/sortFunctions";
import PageHeader from "@/partials/PageHeader.astro";
import PostSidebar from "@/partials/PostSidebar.astro";

export async function getStaticPaths() {
  const paths = [];

  for (const routeLang of supportedLang) {
    const lang = normalizeLang(routeLang);
    const posts = await getSinglePage(BLOG_CONTENT_FOLDER, lang);
    const totalPages = Math.ceil(posts.length / siteConfig.settings.pagination);

    for (let page = 2; page <= totalPages; page++) {
      paths.push({
        params: {
          lang: routeLang || undefined,
          slug: page.toString(),
        },
      });
    }
  }

  return paths;
}

const lang = normalizeLang(Astro.params.lang);
const { slug } = Astro.params;
const postIndex = await getListPage(BLOG_CONTENT_FOLDER, lang, "-index");

if (postIndex.data.draft) {
  return Astro.redirect("/404");
}

const posts = await getSinglePage(BLOG_CONTENT_FOLDER, lang);
const allCategories = await getAllTaxonomy(
  BLOG_CONTENT_FOLDER,
  lang,
  "categories",
);
const categories = await getTaxonomy(BLOG_CONTENT_FOLDER, lang, "categories");
const tags = await getTaxonomy(BLOG_CONTENT_FOLDER, lang, "tags");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / siteConfig.settings.pagination);
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
const indexOfLastPost = currentPage * siteConfig.settings.pagination;
const indexOfFirstPost = indexOfLastPost - siteConfig.settings.pagination;
const currentPosts = sortedPosts.slice(indexOfFirstPost, indexOfLastPost);
const archiveTitle = `${postIndex.data.title} - Page ${currentPage}`;
const archiveDescription =
  postIndex.data.description === "this is meta description"
    ? `Browse page ${currentPage} of the latest articles from ${siteConfig.site.title}, organized by topic and published in reverse chronological order.`
    : `${postIndex.data.description} Page ${currentPage}.`;
const isAIBrandScan = siteConfig.site.title === "AIBrandScan";
---

<Base
  title={archiveTitle}
  meta_title={archiveTitle}
  image={postIndex.data.image}
  description={archiveDescription}
  lang={lang}
>
  {
    isAIBrandScan ? (
      <AIBrandScanArchiveHero
        eyebrow={`AI visibility insights, page ${currentPage}`}
        title={postIndex.data.title}
        description={archiveDescription}
        primaryAction={{ label: "Browse articles", href: "#blog-articles" }}
        secondaryAction={{
          label: "Scan your brand",
          href: "https://aibrandscan.com/register",
        }}
      />
    ) : (
      <PageHeader title={postIndex.data.title} />
    )
  }
  <section id="blog-articles" class="section scroll-mt-24">
    <div class="container">
      <div class="row gx-5">
        <div class="lg:col-8">
          <div class="row">
            {
              currentPosts.map((post) => (
                <div class="mb-8 flex md:col-6">
                  <BlogCard data={post} headingLevel="h2" />
                </div>
              ))
            }
          </div>
          <Pagination
            section="blog"
            currentPage={currentPage}
            totalPages={totalPages}
          />
        </div>

        <PostSidebar
          categories={categories}
          tags={tags}
          allCategories={allCategories}
        />
      </div>
    </div>
  </section>
</Base>
