---
import AIBrandScanPromptSingle from "@/layouts/AIBrandScanPromptSingle.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { siteConfig } from "@/lib/siteConfig";
import { getAuthorProfile } from "@/lib/utils/authors";
import { PROMPTS_CONTENT_FOLDER, promptPath } from "@/lib/utils/promptRoutes";
import {
  normalizeLang,
  stripLocaleFromId,
  supportedLang,
} from "@/lib/utils/languageParser";
import { withSiteMountPath } from "@/lib/utils/mountPath";

export async function getStaticPaths() {
  if (siteConfig.site.title !== "AIBrandScan") return [];

  const paths = [];

  for (const routeLang of supportedLang) {
    const lang = normalizeLang(routeLang);
    const prompts = await getSinglePage(PROMPTS_CONTENT_FOLDER, lang);

    paths.push(
      ...prompts.map((promptEntry) => ({
        params: {
          lang: routeLang || undefined,
          single: stripLocaleFromId(promptEntry.id),
        },
        props: { promptEntry, lang },
      })),
    );
  }

  return paths;
}

const { promptEntry, lang } = Astro.props;
const { title, meta_title, description, image, categories, tags, keywords } =
  promptEntry.data;
const promptSlug = stripLocaleFromId(promptEntry.id);
const canonicalPath = promptPath(promptSlug, lang);
const siteUrl =
  Astro.site ||
  (siteConfig.site.base_url ? new URL(siteConfig.site.base_url) : undefined);
const canonicalUrl = siteUrl
  ? new URL(canonicalPath, siteUrl).toString()
  : canonicalPath;
const imageUrl =
  siteUrl && image
    ? new URL(withSiteMountPath(image), siteUrl).toString()
    : image;
const author = await getAuthorProfile({
  lang,
  authorSlug: promptEntry.data.author,
  siteUrl,
});
const promptKeywords = Array.from(new Set([...tags, ...keywords]));
const promptJsonLd = [
  author.personJsonLd,
  {
    "@type": "HowTo",
    "@id": `${canonicalUrl}#prompt`,
    name: title,
    headline: title,
    description,
    image: imageUrl,
    url: canonicalUrl,
    inLanguage: lang,
    about: categories,
    keywords: promptKeywords.join(", "),
    author: author.id ? { "@id": author.id } : author.personJsonLd,
    supply: promptEntry.data.required_inputs.map((item) => ({
      "@type": "HowToSupply",
      name: item,
    })),
    step: [
      {
        "@type": "HowToStep",
        name: "Prepare the inputs",
        text: "Collect verified brand facts, market context, competitors, buyer questions, and relevant AI answers.",
      },
      {
        "@type": "HowToStep",
        name: "Run the Advanced Prompt",
        text: "Copy the prompt, replace bracketed inputs, and run it in the selected AI assistant.",
      },
      {
        "@type": "HowToStep",
        name: "Review and validate",
        text: "Validate important findings against primary sources and qualified subject matter experts.",
      },
      {
        "@type": "HowToStep",
        name: "Monitor change",
        text: "Repeat important tests consistently or use AI Brand Scan for recurring monitoring.",
      },
    ],
  },
];
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  canonical={canonicalPath}
  lang={lang}
  jsonLd={promptJsonLd}
>
  <AIBrandScanPromptSingle
    promptEntry={promptEntry}
    lang={lang}
    author={author}
  />
</Base>
