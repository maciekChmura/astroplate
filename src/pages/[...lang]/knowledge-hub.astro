---
import AlternativeCard from "@/components/AlternativeCard.astro";
import AudienceCard from "@/components/AudienceCard.astro";
import BlogCard from "@/components/BlogCard.astro";
import ImageMod from "@/components/ImageMod.astro";
import PromptCard from "@/components/PromptCard.astro";
import UseCaseCard from "@/components/UseCaseCard.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { siteConfig } from "@/lib/siteConfig";
import {
  alternativesIndexPath,
  ALTERNATIVES_CONTENT_FOLDER,
} from "@/lib/utils/alternativeRoutes";
import {
  audiencesIndexPath,
  AUDIENCES_CONTENT_FOLDER,
} from "@/lib/utils/audienceRoutes";
import { blogArchivePath, BLOG_CONTENT_FOLDER } from "@/lib/utils/blogRoutes";
import {
  getTranslations,
  normalizeLang,
  slugSelector,
  supportedLang,
} from "@/lib/utils/languageParser";
import {
  promptsIndexPath,
  PROMPTS_CONTENT_FOLDER,
} from "@/lib/utils/promptRoutes";
import {
  useCasesIndexPath,
  USE_CASES_CONTENT_FOLDER,
} from "@/lib/utils/useCaseRoutes";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify } from "@/lib/utils/textConverter";

const HOMEPAGE_FOLDER = "homepage";
const HOMEPAGE_ITEMS = 3;

export function getStaticPaths() {
  if (siteConfig.site.title === "AIBrandScan") {
    return [];
  }

  return supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
}

const lang = normalizeLang(Astro.params.lang);
const homepage = await getListPage(HOMEPAGE_FOLDER, lang, "-index");
const posts = sortByDate(await getSinglePage(BLOG_CONTENT_FOLDER, lang)).slice(
  0,
  HOMEPAGE_ITEMS,
);
const popularPrompts = (await getSinglePage(PROMPTS_CONTENT_FOLDER, lang))
  .filter((prompt) => prompt.data.popular === true)
  .slice(0, HOMEPAGE_ITEMS);
const popularUseCases = (await getSinglePage(USE_CASES_CONTENT_FOLDER, lang))
  .filter((useCase) => useCase.data.popular === true)
  .slice(0, HOMEPAGE_ITEMS);
const popularAudiences = (await getSinglePage(AUDIENCES_CONTENT_FOLDER, lang))
  .filter((audience) => audience.data.popular === true)
  .slice(0, HOMEPAGE_ITEMS);
const popularAlternatives = (
  await getSinglePage(ALTERNATIVES_CONTENT_FOLDER, lang)
)
  .filter((alternative) => alternative.data.popular === true)
  .slice(0, HOMEPAGE_ITEMS);
const translations = (await getTranslations(lang)) as Record<string, string>;

const latestPostsLabel = translations.latest_blog_posts || "Latest blog posts";
const popularPromptsLabel = translations.popular_prompts || "Popular prompts";
const popularUseCasesLabel =
  translations.popular_use_cases || "Popular use cases";
const popularAudiencesLabel =
  translations.popular_audiences || "Popular audiences";
const popularAlternativesLabel =
  translations.popular_alternatives || "Popular alternatives";
const viewAllPostsLabel = translations.view_all_posts || "View all posts";
const browsePromptsLabel = translations.browse_prompts || "Browse prompts";
const browseUseCasesLabel = translations.browse_use_cases || "Browse use cases";
const browseAudiencesLabel =
  translations.browse_audiences || "Browse audiences";
const browseAlternativesLabel =
  translations.browse_alternatives || "Browse alternatives";
const { banner } = homepage.data;
---

<Base
  title={banner.title}
  description={banner.content}
  image={banner.image}
  lang={lang}
>
  <section class="section-sm pb-0">
    <div class="container">
      <div class="row items-center justify-center gy-5">
        <div class="lg:col-6">
          <h1 class="mb-6" set:html={markdownify(banner.title)} />
          <p
            class="mb-8 text-lg leading-8"
            set:html={markdownify(banner.content)}
          />
          {
            banner.button.enable && (
              <div class="flex flex-wrap gap-4">
                <a
                  class="btn btn-primary"
                  href={slugSelector(banner.button.link, lang)}
                >
                  {banner.button.label}
                </a>
              </div>
            )
          }
        </div>
        <div class="lg:col-6">
          <ImageMod
            class="w-full rounded"
            src={banner.image}
            alt={banner.title}
            width={640}
            height={420}
            format="webp"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
        <h2 class="mb-0">{latestPostsLabel}</h2>
        <a class="btn btn-outline-primary btn-sm" href={blogArchivePath(lang)}>
          {viewAllPostsLabel}
        </a>
      </div>
      <div class="row">
        {
          posts.map((post) => (
            <div class="mb-14 md:col-6 lg:col-4">
              <BlogCard data={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    popularUseCases.length > 0 && (
      <section class="section-sm pt-0">
        <div class="container">
          <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
            <h2 class="mb-0">{popularUseCasesLabel}</h2>
            <a
              class="btn btn-outline-primary btn-sm"
              href={useCasesIndexPath(lang)}
            >
              {browseUseCasesLabel}
            </a>
          </div>
          <div class="row">
            {popularUseCases.map((useCase) => (
              <div class="mb-14 md:col-6 lg:col-4">
                <UseCaseCard data={useCase} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    popularAudiences.length > 0 && (
      <section class="section-sm pt-0">
        <div class="container">
          <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
            <h2 class="mb-0">{popularAudiencesLabel}</h2>
            <a
              class="btn btn-outline-primary btn-sm"
              href={audiencesIndexPath(lang)}
            >
              {browseAudiencesLabel}
            </a>
          </div>
          <div class="row">
            {popularAudiences.map((audience) => (
              <div class="mb-14 md:col-6 lg:col-4">
                <AudienceCard data={audience} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    popularAlternatives.length > 0 && (
      <section class="section-sm pt-0">
        <div class="container">
          <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
            <h2 class="mb-0">{popularAlternativesLabel}</h2>
            <a
              class="btn btn-outline-primary btn-sm"
              href={alternativesIndexPath(lang)}
            >
              {browseAlternativesLabel}
            </a>
          </div>
          <div class="row">
            {popularAlternatives.map((alternative) => (
              <div class="mb-14 md:col-6 lg:col-4">
                <AlternativeCard data={alternative} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    popularPrompts.length > 0 && (
      <section class="section-sm pt-0">
        <div class="container">
          <div class="mb-10 flex flex-wrap items-center justify-between gap-4">
            <h2 class="mb-0">{popularPromptsLabel}</h2>
            <a
              class="btn btn-outline-primary btn-sm"
              href={promptsIndexPath(lang)}
            >
              {browsePromptsLabel}
            </a>
          </div>
          <div class="row">
            {popularPrompts.map((prompt) => (
              <div class="mb-14 md:col-6 lg:col-4">
                <PromptCard data={prompt} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
