---
import ImageMod from "@/components/ImageMod.astro";
import { getTranslations, slugSelector } from "@/lib/utils/languageParser";
import { humanize, markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import { FaRegFolder, FaRegUser } from "react-icons/fa";

type ComparisonRow = {
  label: string;
  competitor: string;
  quickarchviz: string;
};

type ComparisonMatrix = {
  columns: string[];
  rows: {
    label: string;
    values: string[];
  }[];
};

type FeatureComparison = ComparisonRow & {
  title: string;
  summary?: string;
};

type NamedDescription = {
  title: string;
  description: string;
};

type AlternativeFaq = {
  question: string;
  answer: string;
};

const { alternativeEntry, lang, author } = Astro.props;
const { Content } = await render(alternativeEntry);
const {
  title,
  description,
  image,
  categories,
  tags,
  competitor_name,
  competitor_url,
  competitor_summary,
  quickarchviz_summary,
  best_for_competitor,
  best_for_quickarchviz,
  comparison_rows,
  comparison_matrix,
  feature_comparison,
  pricing_comparison,
  use_cases,
  common_alternatives,
  faq,
  cta,
} = alternativeEntry.data;
const translations = (await getTranslations(lang)) as Record<string, string>;
const comparisonLabel =
  translations.alternative_quick_comparison || "Quick comparison";
const alternativeBadgeLabel = (
  translations.alternative_badge || "{competitor} alternative"
).replace("{competitor}", competitor_name);
const whatIsCompetitorLabel = (
  translations.alternative_what_is_competitor || "What Is {competitor}?"
).replace("{competitor}", competitor_name);
const whatIsQuickArchVizLabel =
  translations.alternative_what_is_quickarchviz || "What Is QuickArchViz?";
const chooseCompetitorLabel = (
  translations.alternative_choose_competitor || "Choose {competitor} if..."
).replace("{competitor}", competitor_name);
const chooseQuickArchVizLabel =
  translations.alternative_choose_quickarchviz || "Choose QuickArchViz if...";
const featureComparisonLabel =
  translations.alternative_feature_comparison || "Feature comparison";
const pricingComparisonLabel =
  translations.alternative_pricing_comparison || "Pricing comparison";
const useCasesLabel = translations.alternative_use_cases || "Use cases";
const commonAlternativesLabel =
  translations.alternative_common_alternatives || "Common alternatives";
const matrixDefaultLabel =
  translations.alternative_matrix_default || "Comparison matrix";
const matrixFeatureLabel = translations.alternative_matrix_feature || "Feature / Vector";
const faqLabel = translations.use_case_faq || "FAQ";
const hasBodyContent = Boolean(alternativeEntry.body?.trim());
const showMeta = Boolean(author?.name || categories.length > 0);
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-10">
        <header class="mb-12 rounded bg-light p-8 ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border lg:p-10">
          <div class="mb-6 flex flex-wrap gap-2">
            <span class="rounded border border-border bg-white px-3 py-1 text-sm font-medium text-text-dark dark:border-darkmode-border dark:bg-darkmode-body dark:text-darkmode-text">
              {alternativeBadgeLabel}
            </span>
          </div>
          <h1 set:html={markdownify(title)} class="h1 mb-5 max-w-5xl" />
          <p
            class="mb-6 max-w-4xl text-lg leading-8 text-text dark:text-darkmode-text"
            set:html={markdownify(description)}
          />
          {
            showMeta && (
              <ul class="mb-0 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                {author?.name && (
                  <li>
                    <FaRegUser className={"mr-2 -mt-1 inline-block"} />
                    {author?.url ? (
                      <a href={author.url}>{author.name}</a>
                    ) : (
                      <span>{author.name}</span>
                    )}
                  </li>
                )}
                {categories.length > 0 && (
                  <li>
                    <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
                    {categories.map((category: string, index: number) => (
                      <span>
                        {humanize(category)}
                        {index !== categories.length - 1 && ", "}
                      </span>
                    ))}
                  </li>
                )}
              </ul>
            )
          }
        </header>

        {
          image && (
            <div class="mb-16">
              <ImageMod
                src={image}
                alt={title}
                width={1200}
                height={460}
                fit="cover"
                class="aspect-[24/9] w-full rounded object-cover"
                format="webp"
              />
            </div>
          )
        }

        {
          hasBodyContent && (
            <div class="content alternative-body mb-16">
              <Content />
            </div>
          )
        }

        <section class="mb-16 grid gap-8 md:grid-cols-2">
          <article class="rounded bg-light p-6 ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border">
            <h2 class="h3 mb-4">{whatIsCompetitorLabel}</h2>
            <div
              class="content"
              set:html={markdownify(competitor_summary, true)}
            />
            {
              competitor_url && (
                <a
                  class="btn btn-outline-primary btn-sm mt-5"
                  href={competitor_url}
                  rel="nofollow noopener"
                  target="_blank"
                >
                  Visit {competitor_name}
                </a>
              )
            }
          </article>
          <article class="rounded bg-light p-6 ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border">
            <h2 class="h3 mb-4">{whatIsQuickArchVizLabel}</h2>
            <div
              class="content"
              set:html={markdownify(quickarchviz_summary, true)}
            />
          </article>
        </section>

        {
          comparison_rows.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-6">{comparisonLabel}</h2>
              <div class="overflow-x-auto rounded bg-light ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border">
                <table class="w-full min-w-[680px] text-left">
                  <thead>
                    <tr class="border-b border-border dark:border-darkmode-border">
                      <th class="p-4">Criteria</th>
                      <th class="p-4">{competitor_name}</th>
                      <th class="p-4">QuickArchViz</th>
                    </tr>
                  </thead>
                  <tbody>
                    {comparison_rows.map((row: ComparisonRow) => (
                      <tr class="border-b border-border last:border-b-0 dark:border-darkmode-border">
                        <th class="p-4 align-top font-semibold text-text-dark dark:text-darkmode-text">
                          {row.label}
                        </th>
                        <td class="p-4 align-top">{row.competitor}</td>
                        <td class="p-4 align-top">{row.quickarchviz}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )
        }

        {
          comparison_matrix?.rows?.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-6">
                {comparison_matrix.title || matrixDefaultLabel}
              </h2>
              <div class="overflow-x-auto rounded bg-light ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border">
                <table class="w-full min-w-[780px] text-left">
                  <thead>
                    <tr class="border-b border-border dark:border-darkmode-border">
                      <th class="p-4">{matrixFeatureLabel}</th>
                      {comparison_matrix.columns.map((column: string) => (
                        <th class="p-4">{column}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {comparison_matrix.rows.map(
                      (row: ComparisonMatrix["rows"][number]) => (
                        <tr class="border-b border-border last:border-b-0 dark:border-darkmode-border">
                          <th class="p-4 align-top font-semibold text-text-dark dark:text-darkmode-text">
                            {row.label}
                          </th>
                          {row.values.map((value: string, index: number) => (
                            <td
                              class:list={[
                                "p-4 align-top",
                                index === comparison_matrix.columns.length - 1 &&
                                  "bg-white/70 font-medium text-text-dark dark:bg-darkmode-body/40 dark:text-darkmode-text",
                              ]}
                            >
                              {value}
                            </td>
                          ))}
                        </tr>
                      ),
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          )
        }

        <section class="mb-16 grid gap-8 md:grid-cols-2">
          {
            best_for_competitor.length > 0 && (
              <article>
                <h2 class="h3 mb-6">{chooseCompetitorLabel}</h2>
                <div class="grid gap-3">
                  {best_for_competitor.map((item: string) => (
                    <div class="rounded bg-light px-5 py-4 font-medium text-text-dark ring-1 ring-border dark:bg-darkmode-light dark:text-darkmode-text dark:ring-darkmode-border">
                      {item}
                    </div>
                  ))}
                </div>
              </article>
            )
          }
          {
            best_for_quickarchviz.length > 0 && (
              <article>
                <h2 class="h3 mb-6">{chooseQuickArchVizLabel}</h2>
                <div class="grid gap-3">
                  {best_for_quickarchviz.map((item: string) => (
                    <div class="rounded bg-light px-5 py-4 font-medium text-text-dark ring-1 ring-border dark:bg-darkmode-light dark:text-darkmode-text dark:ring-darkmode-border">
                      {item}
                    </div>
                  ))}
                </div>
              </article>
            )
          }
        </section>

        {
          feature_comparison.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-8 text-center">{featureComparisonLabel}</h2>
              <div class="grid gap-6">
                {feature_comparison.map((item: FeatureComparison) => (
                  <article class="rounded bg-light p-6 ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border">
                    <h3 class="h4 mb-4 text-center">{item.title}</h3>
                    <div class="grid gap-4 md:grid-cols-2">
                      <div>
                        <p class="mb-2 text-center font-semibold text-text-dark dark:text-darkmode-text">
                          {competitor_name}
                        </p>
                        <p class="mb-0">{item.competitor}</p>
                      </div>
                      <div>
                        <p class="mb-2 text-center font-semibold text-text-dark dark:text-darkmode-text">
                          QuickArchViz
                        </p>
                        <p class="mb-0">{item.quickarchviz}</p>
                      </div>
                    </div>
                    {item.summary && (
                      <p class="mb-0 mt-5 font-medium">{item.summary}</p>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )
        }

        {
          pricing_comparison.length > 0 && (
            <section class="content mb-16">
              <h2>{pricingComparisonLabel}</h2>
              {pricing_comparison.map((item: NamedDescription) => (
                <article>
                  <h3>{item.title}</h3>
                  <div set:html={markdownify(item.description, true)} />
                </article>
              ))}
            </section>
          )
        }

        {
          use_cases.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-6">{useCasesLabel}</h2>
              <div class="grid gap-4 md:grid-cols-2">
                {use_cases.map((item: NamedDescription) => (
                  <article class="rounded bg-light p-5 ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border">
                    <h3 class="h5 mb-3">{item.title}</h3>
                    <p class="mb-0">{item.description}</p>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        {
          common_alternatives.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-6">{commonAlternativesLabel}</h2>
              <div class="grid gap-4 md:grid-cols-2">
                {common_alternatives.map((item: NamedDescription) => (
                  <article class="rounded bg-light p-5 ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border">
                    <h3 class="h5 mb-3">{item.title}</h3>
                    <p class="mb-0">{item.description}</p>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        {
          faq.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-6">{faqLabel}</h2>
              <div class="grid gap-4">
                {faq.map((item: AlternativeFaq) => (
                  <details class="rounded bg-light p-5 ring-1 ring-border dark:bg-darkmode-light dark:ring-darkmode-border">
                    <summary class="cursor-pointer font-secondary text-lg font-semibold text-text-dark dark:text-darkmode-text">
                      {item.question}
                    </summary>
                    <p
                      class="mb-0 mt-4"
                      set:html={markdownify(item.answer)}
                    />
                  </details>
                ))}
              </div>
            </section>
          )
        }

        {
          cta?.enable && (
            <section class="mb-10 rounded bg-[#101828] p-8 text-center text-white shadow-sm ring-1 ring-[#263248]">
              {cta.title && (
                <h2 class="h3 mb-4 text-white">{cta.title}</h2>
              )}
              {cta.description && (
                <p class="mx-auto mb-6 max-w-2xl text-white/80">
                  {cta.description}
                </p>
              )}
              <a
                class="btn border-white bg-white text-[#101828] hover:border-white hover:bg-transparent hover:text-white"
                href={slugSelector(cta.link, lang)}
              >
                {cta.label}
              </a>
            </section>
          )
        }

        {
          tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              {tags.map((tag: string) => (
                <span class="rounded bg-light px-3 py-1 text-sm dark:bg-darkmode-light">
                  {humanize(tag)}
                </span>
              ))}
            </div>
          )
        }
      </article>
    </div>
  </div>
</section>
