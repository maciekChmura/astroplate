---
import { markdownify } from "@/lib/utils/textConverter";
import {
  FaArrowRight,
  FaChartLine,
  FaCheck,
  FaCircleExclamation,
  FaMagnifyingGlass,
  FaRegLightbulb,
  FaRobot,
} from "react-icons/fa6";

const { audienceEntry } = Astro.props;
const {
  pain_points,
  workflows,
  audience_groups,
  measurements,
  example_prompts,
  best_fit,
  less_suitable,
  faq,
  cta,
} = audienceEntry.data;

const productUrl = "https://aibrandscan.com";
const aiPlatforms = ["ChatGPT", "Gemini", "Claude", "Perplexity"];
---

<div class="overflow-hidden bg-body dark:bg-darkmode-body">
  <section class="relative border-b border-border py-16 sm:py-20 lg:py-28 dark:border-darkmode-border">
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -left-28 top-8 h-72 w-72 rounded-full bg-cyan-300/20 blur-3xl dark:bg-cyan-400/10"></div>
      <div class="absolute -right-24 bottom-0 h-96 w-96 rounded-full bg-blue-400/15 blur-3xl dark:bg-blue-500/10"></div>
      <div class="absolute inset-0 opacity-[0.035] dark:opacity-[0.06] [background-image:linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] [background-size:48px_48px]"></div>
    </div>

    <div class="container relative">
      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_.95fr]">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 text-sm font-semibold text-cyan-800 dark:border-cyan-800/70 dark:bg-cyan-950/50 dark:text-cyan-200">
            <FaRobot />
            AI brand visibility, made actionable
          </div>
          <h1 class="mb-6 max-w-3xl text-4xl font-extrabold leading-[1.08] tracking-tight text-text-dark sm:text-5xl lg:text-6xl dark:text-darkmode-text-dark">
            See what AI says about your brand.
            <span class="block bg-gradient-to-r from-cyan-500 to-blue-600 bg-clip-text text-transparent">
              Then improve what it gets wrong.
            </span>
          </h1>
          <p class="mb-8 max-w-2xl text-lg leading-8 text-text sm:text-xl dark:text-darkmode-text">
            Discover how leading AI platforms describe, compare, and recommend
            your brand, then turn every visibility gap into a clear next step.
          </p>
          <div class="mb-8 flex flex-col gap-3 sm:flex-row">
            <a class="aibrandscan-button aibrandscan-button-primary" href={productUrl}>
              Run your AI Brand Scan
              <FaArrowRight />
            </a>
            <a class="aibrandscan-button aibrandscan-button-secondary" href="#use-cases">
              Explore use cases
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-sm text-text-light dark:text-darkmode-text-light">
            <span class="mr-1 font-medium">Monitor answers across</span>
            {aiPlatforms.map((platform) => (
              <span class="rounded-full border border-border bg-body px-3 py-1.5 dark:border-darkmode-border dark:bg-darkmode-light">
                {platform}
              </span>
            ))}
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-xl">
          <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-cyan-400/20 to-blue-500/20 blur-2xl"></div>
          <div class="relative overflow-hidden rounded-[1.75rem] border border-slate-200 bg-slate-950 p-3 shadow-2xl shadow-slate-900/20 dark:border-slate-700">
            <div class="rounded-[1.35rem] border border-white/10 bg-slate-900 p-5 sm:p-6">
              <div class="mb-6 flex items-center justify-between">
                <div>
                  <p class="mb-1 text-xs font-semibold uppercase tracking-[.18em] text-cyan-300">Latest scan</p>
                  <p class="text-lg font-semibold text-white">Your brand visibility</p>
                </div>
                <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-300">Live</span>
              </div>

              <div class="mb-4 grid grid-cols-2 gap-3">
                <div class="rounded-2xl border border-white/10 bg-white/[.04] p-4">
                  <p class="mb-2 text-sm text-slate-400">Visibility score</p>
                  <div class="flex items-end gap-2">
                    <strong class="text-4xl text-white">68</strong>
                    <span class="mb-1 text-sm text-emerald-300">+12%</span>
                  </div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/[.04] p-4">
                  <p class="mb-2 text-sm text-slate-400">Prompts monitored</p>
                  <strong class="text-4xl text-white">142</strong>
                </div>
              </div>

              <div class="mb-4 rounded-2xl border border-white/10 bg-white/[.04] p-4">
                <div class="mb-3 flex items-center justify-between">
                  <span class="text-sm font-medium text-white">Share of AI answers</span>
                  <span class="text-xs text-slate-400">vs competitors</span>
                </div>
                <div class="space-y-3">
                  <div>
                    <div class="mb-1 flex justify-between text-xs"><span class="text-cyan-300">Your brand</span><span class="text-white">68%</span></div>
                    <div class="h-2 overflow-hidden rounded-full bg-white/10"><div class="h-full w-[68%] rounded-full bg-gradient-to-r from-cyan-400 to-blue-500"></div></div>
                  </div>
                  <div>
                    <div class="mb-1 flex justify-between text-xs"><span class="text-slate-400">Top competitor</span><span class="text-slate-300">84%</span></div>
                    <div class="h-2 overflow-hidden rounded-full bg-white/10"><div class="h-full w-[84%] rounded-full bg-slate-500"></div></div>
                  </div>
                </div>
              </div>

              <div class="grid gap-3 sm:grid-cols-3">
                <div class="rounded-xl bg-emerald-400/10 p-3">
                  <p class="text-xs text-emerald-300">Positive mentions</p>
                  <strong class="mt-1 block text-xl text-white">73%</strong>
                </div>
                <div class="rounded-xl bg-amber-400/10 p-3">
                  <p class="text-xs text-amber-300">Content gaps</p>
                  <strong class="mt-1 block text-xl text-white">18</strong>
                </div>
                <div class="rounded-xl bg-rose-400/10 p-3">
                  <p class="text-xs text-rose-300">Risky answers</p>
                  <strong class="mt-1 block text-xl text-white">4</strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-cyan-600 dark:text-cyan-300">The visibility gap</span>
        <h2 class="h2 mb-4">AI does not always describe your brand the way you would</h2>
        <p class="text-lg leading-8">Find the gaps before customers, journalists, investors, or partners do.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {pain_points.map((item: string, index: number) => (
          <article class="group rounded-2xl border border-border bg-light p-6 transition duration-300 hover:-translate-y-1 hover:border-cyan-300 hover:shadow-lg dark:border-darkmode-border dark:bg-darkmode-light dark:hover:border-cyan-700">
            <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-100 text-cyan-700 dark:bg-cyan-900/50 dark:text-cyan-200">
              {index % 3 === 0 ? <FaMagnifyingGlass /> : index % 3 === 1 ? <FaCircleExclamation /> : <FaRegLightbulb />}
            </div>
            <div class="content prose-p:leading-7 [&_p:last-child]:mb-0" set:html={markdownify(item, true)} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-light py-16 sm:py-20 dark:border-darkmode-border dark:bg-darkmode-light">
    <div class="container">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-cyan-600 dark:text-cyan-300">From insight to action</span>
          <h2 class="h2 mb-5">A report should be the beginning, not the finish line</h2>
          <p class="mb-8 text-lg leading-8">
            AIBrandScan agents help turn findings into content briefs, page updates,
            FAQ ideas, comparison content, schema suggestions, messaging improvements,
            and client-ready reports.
          </p>
          <div class="space-y-4">
            {[
              ["Scan", "Collect repeatable answers across AI platforms."],
              ["Understand", "Compare mentions, competitors, sentiment, and accuracy."],
              ["Improve", "Prepare focused actions while your team stays in control."],
            ].map(([title, description], index) => (
              <div class="flex gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-900 font-bold text-white dark:bg-cyan-300 dark:text-slate-950">{index + 1}</div>
                <div>
                  <h3 class="mb-1 text-lg font-bold text-text-dark dark:text-darkmode-text-dark">{title}</h3>
                  <p class="mb-0">{description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="rounded-3xl border border-border bg-body p-6 shadow-xl shadow-slate-900/5 sm:p-8 dark:border-darkmode-border dark:bg-darkmode-body">
          <div class="mb-6 flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-100 text-violet-700 dark:bg-violet-900/50 dark:text-violet-200"><FaRobot /></div>
            <div>
              <p class="mb-0 font-bold text-text-dark dark:text-darkmode-text-dark">Agent recommendations</p>
              <p class="mb-0 text-sm">Generated from your latest scan</p>
            </div>
          </div>
          <div class="space-y-3">
            {[
              "Create a comparison page for the highest-visibility competitor",
              "Update the product FAQ with three missing buyer questions",
              "Clarify outdated pricing information found in AI answers",
              "Add structured data to strengthen product and organization signals",
            ].map((item, index) => (
              <div class="flex items-start gap-3 rounded-xl border border-border p-4 dark:border-darkmode-border">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-200">{index + 1}</span>
                <p class="mb-0 text-sm leading-6">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="use-cases" class="section-sm scroll-mt-24">
    <div class="container">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-cyan-600 dark:text-cyan-300">Choose your use case</span>
        <h2 class="h2 mb-4">Start with the question your team needs answered</h2>
        <p class="text-lg">Each workflow gives you evidence, context, and a practical route forward.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {workflows.map((workflow: any, index: number) => (
          <article class="group flex h-full flex-col rounded-2xl border border-border bg-body p-6 transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-darkmode-border dark:bg-darkmode-body">
            <div class="mb-5 flex items-center justify-between">
              <span class="text-sm font-bold text-cyan-600 dark:text-cyan-300">0{index + 1}</span>
              <FaArrowRight className="text-text-light transition-transform group-hover:translate-x-1" />
            </div>
            <h3 class="h4 mb-3">{workflow.title}</h3>
            <p class="mb-6 grow leading-7">{workflow.description}</p>
            <a class="font-semibold text-text-dark hover:text-cyan-600 dark:text-darkmode-text-dark dark:hover:text-cyan-300" href={workflow.link}>
              {workflow.label} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-slate-950 py-16 text-slate-300 sm:py-20 dark:border-darkmode-border">
    <div class="container">
      <div class="mb-12 max-w-3xl">
        <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-cyan-300">Built for modern discovery</span>
        <h2 class="mb-4 text-3xl font-bold text-white sm:text-4xl">For teams that depend on visibility, trust, and recommendations</h2>
        <p class="text-lg leading-8 text-slate-400">Choose the perspective closest to your business. The platform adapts to the questions and outcomes your team owns.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {audience_groups.map((group: any) => (
          <article class="rounded-2xl border border-white/10 bg-white/[.04] p-5 transition hover:border-cyan-400/50 hover:bg-white/[.07]">
            <h3 class="mb-3 text-lg font-bold text-white">{group.title}</h3>
            <p class="mb-4 text-sm leading-6 text-slate-400">{group.description}</p>
            {group.outcome && (
              <p class="mb-0 border-t border-white/10 pt-4 text-sm font-medium text-cyan-300">{group.outcome}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
        <div>
          <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-cyan-600 dark:text-cyan-300">Clear evidence</span>
          <h2 class="h2 mb-5">Know what changed and where to act</h2>
          <p class="mb-7 text-lg leading-8">
            Replace random manual checks with a consistent view of how AI systems
            represent your brand across discovery and buying questions.
          </p>
          <a class="aibrandscan-button aibrandscan-button-secondary" href={productUrl}>
            Start monitoring <FaArrowRight />
          </a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {measurements.map((metric: any) => (
            <div class="rounded-xl border border-border bg-light p-5 dark:border-darkmode-border dark:bg-darkmode-light">
              <FaChartLine className="mb-4 text-cyan-600 dark:text-cyan-300" />
              <h3 class="mb-2 font-bold text-text-dark dark:text-darkmode-text-dark">{metric.label}</h3>
              <p class="mb-0 text-sm leading-6">{metric.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-light py-16 sm:py-20 dark:border-darkmode-border dark:bg-darkmode-light">
    <div class="container">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-cyan-600 dark:text-cyan-300">Real buyer questions</span>
          <h2 class="h2 mb-5">Monitor the prompts that shape decisions</h2>
          <p class="text-lg leading-8">See whether AI mentions you when buyers research, compare, validate, and shortlist brands.</p>
        </div>
        <div class="rounded-3xl bg-slate-950 p-5 shadow-xl sm:p-7">
          <div class="mb-4 flex items-center gap-2 border-b border-white/10 pb-4">
            <span class="h-3 w-3 rounded-full bg-rose-400"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
            <span class="ml-3 text-xs text-slate-500">Prompt monitor</span>
          </div>
          <div class="space-y-2">
            {example_prompts.slice(0, 6).map((prompt: string) => (
              <div class="flex items-start gap-3 rounded-xl bg-white/[.05] px-4 py-3 text-sm text-slate-300">
                <span class="text-cyan-300">›</span>
                <span>{prompt}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-cyan-600 dark:text-cyan-300">Best fit</span>
        <h2 class="h2 mb-4">Is AIBrandScan right for your team?</h2>
      </div>
      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-2">
        <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-7 dark:border-emerald-900 dark:bg-emerald-950/30">
          <h3 class="h4 mb-5 text-emerald-900 dark:text-emerald-100">Strong fit if…</h3>
          <ul class="space-y-4">
            {best_fit.map((item: string) => (
              <li class="flex gap-3 text-emerald-950 dark:text-emerald-100">
                <FaCheck className="mt-1 shrink-0 text-emerald-600" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-3xl border border-border bg-light p-7 dark:border-darkmode-border dark:bg-darkmode-light">
          <h3 class="h4 mb-5">May be less useful if…</h3>
          <ul class="space-y-4">
            {less_suitable.map((item: string) => (
              <li class="flex gap-3">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-text-light"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-light py-16 sm:py-20 dark:border-darkmode-border dark:bg-darkmode-light">
    <div class="container">
      <div class="mx-auto max-w-4xl">
        <div class="mb-10 text-center">
          <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-cyan-600 dark:text-cyan-300">FAQ</span>
          <h2 class="h2">Questions teams ask before their first scan</h2>
        </div>
        <div class="space-y-3">
          {faq.map((item: any) => (
            <details class="group rounded-2xl border border-border bg-body p-5 open:shadow-md dark:border-darkmode-border dark:bg-darkmode-body">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-bold text-text-dark dark:text-darkmode-text-dark">
                {item.question}
                <span class="text-xl font-normal text-cyan-600 transition group-open:rotate-45 dark:text-cyan-300">+</span>
              </summary>
              <p class="mb-0 mt-4 max-w-3xl border-t border-border pt-4 leading-7 dark:border-darkmode-border">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  {cta?.enable && (
    <section class="py-16 sm:py-20">
      <div class="container">
        <div class="relative overflow-hidden rounded-[2rem] border border-cyan-200 bg-gradient-to-br from-cyan-50 via-white to-blue-100 px-6 py-14 text-center text-slate-950 shadow-xl shadow-cyan-950/10 sm:px-12 dark:border-cyan-800 dark:from-cyan-950 dark:via-slate-900 dark:to-blue-950 dark:text-white">
          <div class="absolute -left-20 -top-24 h-64 w-64 rounded-full bg-cyan-300/35 blur-3xl dark:bg-cyan-400/20"></div>
          <div class="absolute -bottom-24 -right-20 h-64 w-64 rounded-full bg-blue-300/35 blur-3xl dark:bg-blue-500/20"></div>
          <div class="relative mx-auto max-w-3xl">
            <h2 class="mb-5 text-3xl font-bold text-slate-950 sm:text-4xl dark:text-white">{cta.title}</h2>
            <p class="mx-auto mb-8 max-w-2xl text-lg leading-8 text-slate-700 dark:text-slate-200">{cta.description}</p>
            <a class="aibrandscan-button aibrandscan-button-primary" href={cta.link}>
              {cta.label} <FaArrowRight />
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</div>
