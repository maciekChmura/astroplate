---
import {
  FaArrowRight,
  FaCheck,
  FaCircleExclamation,
  FaMagnifyingGlass,
  FaRobot,
} from "react-icons/fa6";
import { getLangFromUrl } from "@/lib/utils/languageParser";

const { audienceEntry } = Astro.props;
const {
  audience_label,
  audience_groups,
  best_fit,
  less_suitable,
  cta,
} = audienceEntry.data;

const lang = getLangFromUrl(Astro.url);
const productUrl = "https://aibrandscan.com";
const primaryAudiences = audience_groups.slice(0, 6);
const featuredAudiences = audience_groups.slice(0, 4);
const aiPlatforms = ["ChatGPT", "Gemini", "Claude", "Perplexity"];
const copy =
  lang === "pl"
    ? {
        heroTitle: "Dla kogo jest AI Brand Scan?",
        heroHighlight: "Dla zespołów, które AI powinno rozumieć i polecać.",
        primaryCta: "Uruchom AI Brand Scan",
        secondaryCta: "Zobacz dla kogo",
        monitorLabel: "Monitoruj odpowiedzi w",
        bestFit: "Najlepsze dopasowanie",
        bestFitTitle: "Zespoły, których kupujący porównują opcje w AI",
        whoLabel: "Dla kogo",
        whoTitle: "Stworzone dla zespołów, które muszą być widoczne, porównywane i wiarygodne w odpowiedziach AI",
        whoDescription:
          "Jeśli kupujący pytają AI, którą markę, narzędzie, agencję, produkt albo usługę wybrać, ta sekcja jest dla Ciebie.",
        outcomeLabel: "Co możesz poprawić",
        workflowLabel: "Zastosowania",
        workflowTitle: "Zamień pytania o widoczność w AI w konkretne decyzje",
        workflowDescription:
          "Zacznij od pytania biznesowego, a potem sprawdź widoczność marki, konkurencję, dokładność odpowiedzi, ryzyka reputacyjne i luki contentowe.",
        strongFit: "Dobry wybór, jeśli…",
        lessUseful: "Mniej przydatne, jeśli…",
      }
    : {
        heroTitle: "Who should use AI Brand Scan?",
        primaryCta: "Run your AI Brand Scan",
        secondaryCta: "See who it is for",
        monitorLabel: "Monitor answers across",
        bestFit: "Best fit",
        bestFitTitle: "Teams whose buyers compare options in AI",
        whoLabel: "Who it helps",
        whoTitle: "Built for teams that need to be found, compared, and trusted in AI answers",
        whoDescription:
          "If buyers ask AI which brand, tool, product, agency, or provider to choose, these are the teams that benefit most.",
        outcomeLabel: "What this improves",
        strongFit: "Strong fit if…",
        lessUseful: "Less useful if…",
      };
---

<div class="overflow-hidden bg-body dark:bg-darkmode-body">
  <section class="relative border-b border-slate-200 bg-[#fbfaf8] py-14 sm:py-16 lg:py-20 dark:border-darkmode-border dark:bg-darkmode-body">
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute inset-0 opacity-[0.45] [background-image:linear-gradient(to_right,#1118270a_1px,transparent_1px),linear-gradient(to_bottom,#1118270a_1px,transparent_1px)] [background-size:44px_44px] dark:opacity-[0.08]"></div>
      <div class="aibrandscan-grid-sparkles" aria-hidden="true">
        {Array.from({ length: 12 }).map(() => <span />)}
      </div>
      <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-white to-transparent dark:from-darkmode-body"></div>
    </div>

    <div class="container relative">
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_.9fr]">
        <div>
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-4 py-2 text-sm font-semibold text-slate-950 shadow-sm dark:border-orange-900/50 dark:bg-orange-950/30 dark:text-white">
            <FaRobot />
            {audience_label}
          </div>
          <h1 class="mb-6 max-w-3xl text-4xl font-extrabold leading-[1.06] tracking-[-0.04em] text-slate-950 sm:text-5xl lg:text-6xl dark:text-darkmode-text-dark">
            {copy.heroTitle}
            <span class="block text-orange-600">
              {copy.heroHighlight}
            </span>
          </h1>
          <p class="mb-7 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl dark:text-darkmode-text">
            {audienceEntry.data.description}
          </p>
          <div class="mb-7 flex flex-col gap-3 sm:flex-row">
            <a class="aibrandscan-button aibrandscan-button-primary" href={productUrl}>
              {copy.primaryCta}
              <FaArrowRight />
            </a>
            <a class="aibrandscan-button aibrandscan-button-secondary" href="#who-for">
              {copy.secondaryCta}
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-darkmode-text-light">
            <span class="mr-1 font-medium text-slate-700 dark:text-darkmode-text">{copy.monitorLabel}</span>
            {aiPlatforms.map((platform) => (
              <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 shadow-sm dark:border-darkmode-border dark:bg-darkmode-light">
                {platform}
              </span>
            ))}
          </div>
        </div>

        <div class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-[0_18px_50px_rgba(15,23,42,0.08)] dark:border-darkmode-border dark:bg-darkmode-light sm:p-6">
          <div class="mb-5 flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-100 text-slate-400 dark:bg-slate-900/60 dark:text-slate-500">
              <FaMagnifyingGlass />
            </div>
            <div>
              <p class="mb-0 text-sm font-bold uppercase tracking-[.16em] text-slate-400 dark:text-slate-500">
                {copy.bestFit}
              </p>
              <h2 class="mb-0 text-xl font-extrabold tracking-[-0.02em] text-slate-950 dark:text-darkmode-text-dark">
                {copy.bestFitTitle}
              </h2>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {featuredAudiences.map((group: any) => (
              <article class="rounded-2xl border border-slate-200 bg-[#fbfaf8] p-4 dark:border-darkmode-border dark:bg-darkmode-body">
                <h3 class="mb-2 text-base font-extrabold text-orange-600 dark:text-orange-300">
                  {group.title}
                </h3>
                <p class="mb-0 text-sm leading-6 text-slate-600 dark:text-darkmode-text">{group.description}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="who-for" class="section-sm scroll-mt-24">
    <div class="container">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-orange-600 dark:text-orange-300">
          {copy.whoLabel}
        </span>
        <h2 class="h2 mb-4">{copy.whoTitle}</h2>
        <p class="mb-0 text-lg leading-8 text-slate-600 dark:text-darkmode-text">
          {copy.whoDescription}
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {primaryAudiences.map((group: any, index: number) => (
          <article class="rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-[0_10px_30px_rgba(15,23,42,0.05)] transition duration-300 hover:-translate-y-1 hover:border-orange-300 hover:shadow-[0_18px_45px_rgba(15,23,42,0.09)] dark:border-darkmode-border dark:bg-darkmode-light dark:hover:border-orange-700">
            <div class="mb-5 font-mono text-sm font-bold tracking-[0.18em] text-slate-400 dark:text-slate-500">
              [{index + 1}]
            </div>
            <h3 class="mb-3 text-xl font-extrabold tracking-[-0.02em] text-orange-600 dark:text-orange-300">
              {group.title}
            </h3>
            <p class="mb-4 leading-7 text-slate-600 dark:text-darkmode-text">{group.description}</p>
            {group.outcome && (
              <div class="mb-0 border-t border-slate-200 pt-4 dark:border-darkmode-border">
                <p class="mb-1 text-xs font-black uppercase tracking-[.14em] text-slate-950 dark:text-white">
                  {copy.outcomeLabel}
                </p>
                <p class="mb-0 text-sm font-semibold text-slate-950 dark:text-darkmode-text-dark">
                {group.outcome}
                </p>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="mx-auto grid max-w-5xl gap-5 lg:grid-cols-2">
          <div class="rounded-[1.75rem] border border-orange-200 bg-orange-50 p-7 dark:border-orange-900 dark:bg-orange-950/30">
            <h3 class="h4 mb-5 text-slate-950 dark:text-orange-100">{copy.strongFit}</h3>
            <ul class="space-y-4">
              {best_fit.map((item: string) => (
                <li class="flex gap-3 text-slate-800 dark:text-orange-100">
                  <FaCheck className="mt-1 shrink-0 text-orange-600" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-7 shadow-sm dark:border-darkmode-border dark:bg-darkmode-light">
            <h3 class="h4 mb-5">{copy.lessUseful}</h3>
            <ul class="space-y-4">
              {less_suitable.map((item: string) => (
                <li class="flex gap-3 text-slate-700 dark:text-darkmode-text">
                  <FaCircleExclamation className="mt-1 shrink-0 text-slate-400" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
      </div>
    </div>
  </section>

  {cta?.enable && (
    <section class="py-16 sm:py-20">
      <div class="container">
        <div class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-[#fbfaf8] px-6 py-14 text-center text-slate-950 shadow-[0_18px_50px_rgba(15,23,42,0.08)] sm:px-12 dark:border-darkmode-border dark:bg-darkmode-light dark:text-white">
          <div class="absolute inset-0 opacity-[0.5] [background-image:linear-gradient(to_right,#1118270a_1px,transparent_1px),linear-gradient(to_bottom,#1118270a_1px,transparent_1px)] [background-size:42px_42px] dark:opacity-[0.08]"></div>
          <div class="relative mx-auto max-w-3xl">
            <h2 class="mb-5 text-3xl font-bold text-slate-950 sm:text-4xl dark:text-white">{cta.title}</h2>
            <p class="mx-auto mb-8 max-w-2xl text-lg leading-8 text-slate-700 dark:text-slate-200">{cta.description}</p>
            <a class="aibrandscan-button aibrandscan-button-primary" href={cta.link}>
              {cta.label} <FaArrowRight />
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</div>
