---
import ImageMod from "./ImageMod.astro";

interface Props {
  src?: string;
  alt: string;
  width: number;
  height: number;
  seed?: string;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  class?: string;
  style?: Record<string, string | number>;
}

const PLACEHOLDER_IMAGE = "/sites/quickarchviz/images/image-placeholder.png";

const {
  src,
  alt,
  width,
  height,
  seed = alt,
  loading,
  decoding,
  format,
  fit,
  class: className,
  style,
} = Astro.props;

function hashSeed(value: string) {
  return Array.from(value).reduce(
    (hash, character) => (hash * 31 + character.charCodeAt(0)) >>> 0,
    0,
  );
}

const isPlaceholder = src === PLACEHOLDER_IMAGE;
const gradientIndex = hashSeed(seed) % 8;
const visualStyle = {
  ...style,
  "--prompt-visual-aspect": `${width} / ${height}`,
};
---

{
  src &&
    (isPlaceholder ? (
      <div
        class:list={[
          "prompt-visual",
          `prompt-visual--${gradientIndex}`,
          className,
        ]}
        style={visualStyle}
        role="img"
        aria-label={alt}
      />
    ) : (
      <ImageMod
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding={decoding}
        format={format}
        fit={fit}
        class={className}
        style={style}
      />
    ))
}

<style>
  .prompt-visual {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: var(--prompt-visual-aspect);
    background:
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.34), transparent 28%),
      radial-gradient(circle at 82% 22%, rgba(255, 255, 255, 0.18), transparent 24%),
      linear-gradient(135deg, #0f766e 0%, #14b8a6 46%, #f59e0b 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.18),
      inset 0 -48px 80px rgba(0, 0, 0, 0.18);
  }

  .prompt-visual::before,
  .prompt-visual::after {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
  }

  .prompt-visual::before {
    z-index: 1;
    opacity: 0.42;
    background-image:
      radial-gradient(rgba(255, 255, 255, 0.55) 0.7px, transparent 0.7px),
      radial-gradient(rgba(0, 0, 0, 0.28) 0.6px, transparent 0.6px);
    background-position:
      0 0,
      2px 2px;
    background-size:
      4px 4px,
      5px 5px;
    mix-blend-mode: overlay;
  }

  .prompt-visual::after {
    z-index: 2;
    opacity: 0.24;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.42) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.42) 1px, transparent 1px),
      linear-gradient(135deg, transparent 0 48%, rgba(255, 255, 255, 0.26) 49% 51%, transparent 52%);
    background-size:
      32px 32px,
      32px 32px,
      96px 96px;
    mask-image: radial-gradient(circle at 50% 45%, black 0 52%, transparent 78%);
  }

  .prompt-visual--0 {
    background:
      radial-gradient(circle at 16% 18%, rgba(255, 255, 255, 0.32), transparent 28%),
      radial-gradient(circle at 86% 16%, rgba(251, 191, 36, 0.62), transparent 24%),
      linear-gradient(135deg, #0f766e 0%, #14b8a6 48%, #f97316 100%);
  }

  .prompt-visual--1 {
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.3), transparent 28%),
      radial-gradient(circle at 80% 22%, rgba(45, 212, 191, 0.52), transparent 26%),
      linear-gradient(135deg, #164e63 0%, #2563eb 46%, #a855f7 100%);
  }

  .prompt-visual--2 {
    background:
      radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.34), transparent 28%),
      radial-gradient(circle at 80% 18%, rgba(244, 114, 182, 0.52), transparent 26%),
      linear-gradient(135deg, #581c87 0%, #db2777 48%, #f59e0b 100%);
  }

  .prompt-visual--3 {
    background:
      radial-gradient(circle at 22% 18%, rgba(255, 255, 255, 0.32), transparent 28%),
      radial-gradient(circle at 82% 22%, rgba(190, 242, 100, 0.58), transparent 26%),
      linear-gradient(135deg, #14532d 0%, #16a34a 46%, #06b6d4 100%);
  }

  .prompt-visual--4 {
    background:
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.3), transparent 28%),
      radial-gradient(circle at 82% 20%, rgba(253, 186, 116, 0.56), transparent 26%),
      linear-gradient(135deg, #7f1d1d 0%, #f97316 48%, #fde047 100%);
  }

  .prompt-visual--5 {
    background:
      radial-gradient(circle at 20% 18%, rgba(255, 255, 255, 0.32), transparent 28%),
      radial-gradient(circle at 80% 24%, rgba(125, 211, 252, 0.56), transparent 26%),
      linear-gradient(135deg, #1e1b4b 0%, #4f46e5 46%, #22d3ee 100%);
  }

  .prompt-visual--6 {
    background:
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.34), transparent 28%),
      radial-gradient(circle at 82% 20%, rgba(167, 243, 208, 0.56), transparent 26%),
      linear-gradient(135deg, #064e3b 0%, #0f766e 48%, #84cc16 100%);
  }

  .prompt-visual--7 {
    background:
      radial-gradient(circle at 18% 20%, rgba(255, 255, 255, 0.34), transparent 28%),
      radial-gradient(circle at 84% 18%, rgba(216, 180, 254, 0.56), transparent 26%),
      linear-gradient(135deg, #312e81 0%, #7c3aed 46%, #f43f5e 100%);
  }
</style>
