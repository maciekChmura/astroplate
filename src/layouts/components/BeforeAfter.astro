---
import ImageMod from "./ImageMod.astro";

interface ImageItem {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  before: ImageItem;
  after: ImageItem;
  beforeLabel?: string;
  afterLabel?: string;
  class?: string;
}

const {
  before,
  after,
  beforeLabel = "Input",
  afterLabel = "QuickArchViz Result",
  class: className = "",
} = Astro.props;
const initialPosition = 50;
---

<figure
  class:list={[
    "relative overflow-hidden rounded bg-light dark:bg-darkmode-light",
    className,
  ]}
  data-before-after
  style={`--before-after-position: ${initialPosition}%`}
>
  <div class="relative aspect-[16/10] w-full overflow-hidden">
    <ImageMod
      src={after.src}
      alt={after.alt}
      width={1200}
      height={750}
      loading="eager"
      decoding="async"
      fit="cover"
      format="webp"
      class="h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 overflow-hidden"
      data-before-after-overlay
      style={`clip-path: inset(0 ${100 - initialPosition}% 0 0);`}
    >
      <ImageMod
        src={before.src}
        alt={before.alt}
        width={1200}
        height={750}
        loading="eager"
        decoding="async"
        fit="cover"
        format="webp"
        class="h-full w-full object-cover"
      />
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 w-px bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.25)]"
      data-before-after-handle
      style={`left: ${initialPosition}%`}
    >
      <span
        class="absolute top-1/2 left-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-sm font-semibold text-text-dark shadow"
        aria-hidden="true"
      >
        ↔
      </span>
    </div>
    <input
      class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
      type="range"
      min="0"
      max="100"
      value={initialPosition}
      aria-label={`${beforeLabel} and ${afterLabel} comparison`}
      data-before-after-range
    />
    <div
      class="pointer-events-none absolute inset-x-4 top-4 flex justify-between gap-3 text-sm font-semibold"
    >
      <span class="rounded bg-white/90 px-3 py-1 text-text-dark shadow-sm">
        {beforeLabel}
      </span>
      <span class="rounded bg-white/90 px-3 py-1 text-text-dark shadow-sm">
        {afterLabel}
      </span>
    </div>
  </div>
  {
    (before.caption || after.caption) && (
      <figcaption class="px-4 py-3 text-sm text-text dark:text-darkmode-text">
        {[before.caption, after.caption].filter(Boolean).join(" / ")}
      </figcaption>
    )
  }
</figure>

<script>
  document.querySelectorAll("[data-before-after]").forEach((container) => {
    const range = container.querySelector<HTMLInputElement>(
      "[data-before-after-range]",
    );
    const overlay = container.querySelector<HTMLElement>(
      "[data-before-after-overlay]",
    );
    const handle = container.querySelector<HTMLElement>(
      "[data-before-after-handle]",
    );

    if (!range || !overlay || !handle) {
      return;
    }

    const updatePosition = () => {
      const value = Number(range.value);
      overlay.style.clipPath = `inset(0 ${100 - value}% 0 0)`;
      handle.style.left = `${value}%`;
    };

    range.addEventListener("input", updatePosition);
    updatePosition();
  });
</script>
