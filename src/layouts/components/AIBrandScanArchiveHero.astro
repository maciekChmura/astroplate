---
import { FaArrowRight, FaRobot } from "react-icons/fa6";

type HeroAction = {
  label: string;
  href: string;
};

type Props = {
  eyebrow: string;
  title: string;
  description: string;
  primaryAction?: HeroAction;
  secondaryAction?: HeroAction;
};

const {
  eyebrow,
  title,
  description,
  primaryAction,
  secondaryAction,
}: Props = Astro.props;
---

<section class="relative overflow-hidden border-b border-slate-200 bg-[#fbfaf8] py-16 sm:py-20 lg:py-24 dark:border-darkmode-border dark:bg-darkmode-body">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 opacity-[0.45] [background-image:linear-gradient(to_right,#1118270a_1px,transparent_1px),linear-gradient(to_bottom,#1118270a_1px,transparent_1px)] [background-size:44px_44px] dark:opacity-[0.08]"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-white to-transparent dark:from-darkmode-body"></div>
  </div>

  <div class="container relative">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-4 py-2 text-sm font-semibold text-slate-950 shadow-sm dark:border-orange-900/50 dark:bg-orange-950/30 dark:text-white">
        <FaRobot />
        {eyebrow}
      </div>

      <h1 class="mb-6 text-4xl font-extrabold leading-[1.06] tracking-[-0.04em] text-slate-950 sm:text-5xl lg:text-7xl dark:text-darkmode-text-dark">
        {title}
      </h1>
      <p class="mx-auto mb-8 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl dark:text-darkmode-text">
        {description}
      </p>

      {
        (primaryAction || secondaryAction) && (
          <div class="flex flex-col justify-center gap-3 sm:flex-row">
            {primaryAction && (
              <a
                class="aibrandscan-button aibrandscan-button-primary"
                href={primaryAction.href}
              >
                {primaryAction.label}
                <FaArrowRight />
              </a>
            )}
            {secondaryAction && (
              <a
                class="aibrandscan-button aibrandscan-button-secondary"
                href={secondaryAction.href}
              >
                {secondaryAction.label}
                <FaArrowRight />
              </a>
            )}
          </div>
        )
      }

      <slot />
    </div>
  </div>
</section>
