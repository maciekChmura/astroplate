---
import { FaArrowRight, FaRobot } from "react-icons/fa6";

type HeroAction = {
  label: string;
  href: string;
};

type Props = {
  eyebrow: string;
  title: string;
  description: string;
  primaryAction?: HeroAction;
  secondaryAction?: HeroAction;
};

const {
  eyebrow,
  title,
  description,
  primaryAction,
  secondaryAction,
}: Props = Astro.props;
---

<section class="relative overflow-hidden border-b border-border py-16 sm:py-20 lg:py-24 dark:border-darkmode-border">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -left-28 top-8 h-72 w-72 rounded-full bg-cyan-300/20 blur-3xl dark:bg-cyan-400/10"></div>
    <div class="absolute -right-24 bottom-0 h-96 w-96 rounded-full bg-blue-400/15 blur-3xl dark:bg-blue-500/10"></div>
    <div class="absolute inset-0 opacity-[0.035] dark:opacity-[0.06] [background-image:linear-gradient(to_right,currentColor_1px,transparent_1px),linear-gradient(to_bottom,currentColor_1px,transparent_1px)] [background-size:48px_48px]"></div>
  </div>

  <div class="container relative">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 text-sm font-semibold text-cyan-800 dark:border-cyan-800/70 dark:bg-cyan-950/50 dark:text-cyan-200">
        <FaRobot />
        {eyebrow}
      </div>

      <h1 class="mb-6 text-4xl font-extrabold leading-tight tracking-tight text-text-dark sm:text-5xl lg:text-6xl dark:text-darkmode-text-dark">
        {title}
      </h1>
      <p class="mx-auto mb-8 max-w-3xl text-lg leading-8 text-text sm:text-xl dark:text-darkmode-text">
        {description}
      </p>

      {
        (primaryAction || secondaryAction) && (
          <div class="flex flex-col justify-center gap-3 sm:flex-row">
            {primaryAction && (
              <a
                class="aibrandscan-button aibrandscan-button-primary"
                href={primaryAction.href}
              >
                {primaryAction.label}
                <FaArrowRight />
              </a>
            )}
            {secondaryAction && (
              <a
                class="aibrandscan-button aibrandscan-button-secondary"
                href={secondaryAction.href}
              >
                {secondaryAction.label}
                <FaArrowRight />
              </a>
            )}
          </div>
        )
      }

      <slot />
    </div>
  </div>
</section>
