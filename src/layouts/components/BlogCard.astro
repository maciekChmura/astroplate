---
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
  stripLocaleFromId,
} from "@/lib/utils/languageParser";
import { blogPostPath } from "@/lib/utils/blogRoutes";
import { getAuthorProfile } from "@/lib/utils/authors";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { FaRegFolder, FaRegUser } from "react-icons/fa";
import { siteConfig } from "@/lib/siteConfig";
import ImageMod from "./ImageMod.astro";

const { summary_length }: { summary_length: number } = siteConfig.settings;
const { data } = Astro.props;
const { title, image, date, categories } = data.data;
const lang = getLangFromUrl(Astro.url);
const author = await getAuthorProfile({
  lang,
  authorSlug: data.data.author,
});
const { read_more } = (await getTranslations(lang)) as unknown as {
  read_more: string;
};
const postSlug = stripLocaleFromId(data.id);
---

<div class="bg-body dark:bg-darkmode-body">
  {
    image && (
      <ImageMod
        class="mb-6 h-[230px] w-full rounded object-cover"
        src={image}
        alt={title}
        width={445}
        height={230}
        fit="cover"
        format="webp"
      />
    )
  }
  <h4 class="mb-3">
    <a href={blogPostPath(postSlug, lang)}>{title}</a>
  </h4>
  <ul class="mb-4">
    <li class="mr-4 inline-block">
      <FaRegUser className={"mr-2 -mt-1 inline-block"} />
      {
        author.url ? (
          <a href={author.url}>{author.name}</a>
        ) : (
          <span>{author.name}</span>
        )
      }
    </li>
    <li class="mr-4 inline-block">
      <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
      {
        categories.map((category: string, index: number) => (
          <a href={slugSelector(`/categories/${slugify(category)}`, lang)}>
            {humanize(category)}
            {index !== categories.length - 1 && ","}
          </a>
        ))
      }
    </li>
    {date && <li class="inline-block">{dateFormat(date)}</li>}
  </ul>
  <p class="mb-6">{plainify(data.body?.slice(0, Number(summary_length)))}</p>
  <a class="btn btn-outline-primary btn-sm" href={blogPostPath(postSlug, lang)}>
    {read_more}
  </a>
</div>
