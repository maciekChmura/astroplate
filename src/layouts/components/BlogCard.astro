---
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
  stripLocaleFromId,
} from "@/lib/utils/languageParser";
import { blogPostPath } from "@/lib/utils/blogRoutes";
import { getAuthorProfile } from "@/lib/utils/authors";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import {
  FaArrowRight,
  FaRegCalendar,
  FaRegFolder,
  FaRegUser,
} from "react-icons/fa";
import { siteConfig } from "@/lib/siteConfig";
import ImageMod from "./ImageMod.astro";

const { summary_length }: { summary_length: number } = siteConfig.settings;
const {
  data,
  headingLevel = "h3",
} = Astro.props as {
  data: any;
  headingLevel?: "h2" | "h3" | "h4";
};
const { title, description, image, date, categories } = data.data;
const lang = getLangFromUrl(Astro.url);
const author = await getAuthorProfile({
  lang,
  authorSlug: data.data.author,
});
const { read_more } = (await getTranslations(lang)) as unknown as {
  read_more: string;
};
const postSlug = stripLocaleFromId(data.id);
const postUrl = blogPostPath(postSlug, lang);
const isAIBrandScan = siteConfig.site.title === "AIBrandScan";
const Heading = headingLevel;
---

{
  isAIBrandScan ? (
    <article class="group flex h-full w-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-[0_10px_30px_rgba(15,23,42,0.06)] transition duration-300 hover:-translate-y-1 hover:border-orange-300 hover:shadow-[0_18px_45px_rgba(15,23,42,0.1)] dark:border-darkmode-border dark:bg-darkmode-light dark:hover:border-orange-700">
      {
        image && (
          <a class="block overflow-hidden bg-slate-50" href={postUrl} tabindex="-1">
            <ImageMod
              class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
              src={image}
              alt={title}
              width={720}
              height={405}
              fit="cover"
              format="webp"
            />
          </a>
        )
      }
      <div class="flex grow flex-col p-6 sm:p-7">
        <div class="mb-4 flex flex-wrap gap-2">
          {categories.map((category: string) => (
            <a
              class="rounded-full border border-orange-200 bg-orange-50 px-3 py-1 text-xs font-bold text-slate-950 transition hover:border-orange-300 hover:bg-orange-100 dark:border-orange-900/60 dark:bg-orange-950/40 dark:text-white dark:hover:bg-orange-900/60"
              href={slugSelector(`/categories/${slugify(category)}`, lang)}
            >
              {humanize(category)}
            </a>
          ))}
        </div>

        <Heading class="mb-4 text-2xl font-extrabold leading-tight tracking-[-0.02em] text-slate-950 sm:text-[1.65rem] dark:text-darkmode-text-dark">
          <a class="transition group-hover:text-orange-600 dark:group-hover:text-orange-300" href={postUrl}>
            {title}
          </a>
        </Heading>

        <p class="mb-6 line-clamp-3 leading-7 text-slate-600 dark:text-darkmode-text">
          {plainify(description)}
        </p>

        <div class="mt-auto">
          <div class="mb-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-slate-200 pt-5 text-sm text-slate-500 dark:border-darkmode-border dark:text-darkmode-text-light">
            <span class="inline-flex items-center gap-2">
              <FaRegUser className="shrink-0 text-orange-600 dark:text-orange-300" />
              {author.url ? (
                <a class="hover:text-orange-600 dark:hover:text-orange-300" href={author.url}>
                  {author.name}
                </a>
              ) : (
                author.name
              )}
            </span>
            {date && (
              <span class="inline-flex items-center gap-2">
                <FaRegCalendar className="shrink-0 text-orange-600 dark:text-orange-300" />
                <time datetime={new Date(date).toISOString()}>{dateFormat(date)}</time>
              </span>
            )}
          </div>

          <a class="aibrandscan-button aibrandscan-button-primary aibrandscan-button-sm" href={postUrl}>
            {read_more}
            <FaArrowRight className="transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </div>
    </article>
  ) : (
    <div class="bg-body dark:bg-darkmode-body">
      {
        image && (
          <ImageMod
            class="mb-6 h-[230px] w-full rounded object-cover"
            src={image}
            alt={title}
            width={445}
            height={230}
            fit="cover"
            format="webp"
          />
        )
      }
      <h4 class="mb-3">
        <a href={postUrl}>{title}</a>
      </h4>
      <ul class="mb-4">
        <li class="mr-4 inline-block">
          <FaRegUser className={"mr-2 -mt-1 inline-block"} />
          {
            author.url ? (
              <a href={author.url}>{author.name}</a>
            ) : (
              <span>{author.name}</span>
            )
          }
        </li>
        <li class="mr-4 inline-block">
          <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
          {
            categories.map((category: string, index: number) => (
              <a href={slugSelector(`/categories/${slugify(category)}`, lang)}>
                {humanize(category)}
                {index !== categories.length - 1 && ","}
              </a>
            ))
          }
        </li>
        {date && <li class="inline-block">{dateFormat(date)}</li>}
      </ul>
      <p class="mb-6">{plainify(data.body?.slice(0, Number(summary_length)))}</p>
      <a class="btn btn-outline-primary btn-sm" href={postUrl}>
        {read_more}
      </a>
    </div>
  )
}
