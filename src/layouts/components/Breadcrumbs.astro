---
import { humanize } from "@/lib/utils/textConverter";
import {
  getTranslations,
  normalizeLang,
  slugSelector,
} from "@/lib/utils/languageParser";

const { className }: { className?: string } = Astro.props;
const lang = normalizeLang(Astro.currentLocale);
const translations = (await getTranslations(lang)) as Record<string, string>;

const breadcrumbLabels: Record<string, string> = {
  home: translations.breadcrumb_home || "Home",
  for: translations.breadcrumb_for || "For",
};

const getBreadcrumbLabel = (label: string) => {
  const normalizedLabel = label.replace(".html", "").replace(/[-_]/g, " ");
  return breadcrumbLabels[normalizedLabel] || humanize(normalizedLabel) || "";
};

const paths = Astro.url.pathname.split("/").filter((x) => x);
let parts = [
  {
    label: getBreadcrumbLabel("home"),
    href: slugSelector("/", lang),
    "aria-label": Astro.url.pathname === "/" ? "page" : undefined,
  },
];

paths.forEach((label: string, i: number) => {
  const href = `/${paths.slice(0, i + 1).join("/")}`;
  const normalizedHref = slugSelector(href, lang);
  label !== "page" &&
    parts.push({
      label: getBreadcrumbLabel(label),
      href: normalizedHref,
      "aria-label":
        Astro.url.pathname === href || Astro.url.pathname === normalizedHref
          ? "page"
          : undefined,
    });
});
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="inline-flex" role="list">
    {
      parts.map(({ label, ...attrs }, index) => (
        <li class="mx-1 capitalize" role="listitem">
          {index > 0 && <span class="inlin-block mr-1">/</span>}
          {index !== parts.length - 1 ? (
            <a class="text-primary dark:text-darkmode-primary" {...attrs}>
              {label}
            </a>
          ) : (
            <span class="text-text-light dark:text-darkmode-text-light">
              {label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
