---
import { alternativePath } from "@/lib/utils/alternativeRoutes";
import AIBrandScanArchiveHero from "@/components/AIBrandScanArchiveHero.astro";
import { stripLocaleFromId } from "@/lib/utils/languageParser";
import { humanize, plainify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { FaArrowRight } from "react-icons/fa";

const { alternativesIndex, alternatives, lang } = Astro.props as {
  alternativesIndex: CollectionEntry<"alternatives">;
  alternatives: CollectionEntry<"alternatives">[];
  lang: string;
};
---

<AIBrandScanArchiveHero
  eyebrow="Independent comparison guides"
  title={alternativesIndex.data.title}
  description={alternativesIndex.data.description}
  primaryAction={{ label: "Browse comparisons", href: "#comparison-guides" }}
  secondaryAction={{ label: "Scan your brand", href: "https://aibrandscan.com/register" }}
/>

<section id="comparison-guides" class="section scroll-mt-24">
  <div class="container">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">Latest guide</p>
        <h2 class="h2 mb-4">Find the right AI visibility platform</h2>
        <p class="mb-0 text-lg leading-8">
          Compare tools by brand monitoring depth, prompt tracking, citations, answer accuracy, reporting, and the ability to turn findings into action.
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        {alternatives.map((alternative) => {
          const slug = stripLocaleFromId(alternative.id);
          return (
            <article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-border bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-darkmode-border dark:bg-darkmode-light md:p-9">
              <div class="mb-5 flex flex-wrap gap-2">
                {alternative.data.categories.map((category: string) => (
                  <span class="rounded-full border border-orange-100 bg-[#fbfaf8] px-3 py-1 text-xs font-bold text-slate-950 dark:border-orange-900/50 dark:bg-orange-950/20 dark:text-orange-100">
                    {humanize(category)}
                  </span>
                ))}
              </div>
              <h3 class="h3 mb-4">
                <a class="transition hover:text-cyan-700 dark:hover:text-cyan-300" href={alternativePath(slug, lang)}>
                  {alternative.data.title}
                </a>
              </h3>
              <p class="mb-7 text-base leading-7">{plainify(alternative.data.description)}</p>
              <a
                class="aibrandscan-button aibrandscan-button-primary aibrandscan-button-sm mt-auto self-start"
                href={alternativePath(slug, lang)}
              >
                Read the comparison
                <FaArrowRight className="transition group-hover:translate-x-1" />
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>
