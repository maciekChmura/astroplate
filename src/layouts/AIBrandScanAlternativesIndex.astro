---
import { alternativePath } from "@/lib/utils/alternativeRoutes";
import AIBrandScanArchiveHero from "@/components/AIBrandScanArchiveHero.astro";
import { stripLocaleFromId } from "@/lib/utils/languageParser";
import { humanize, plainify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { FaArrowRight } from "react-icons/fa";

const { alternativesIndex, alternatives, lang } = Astro.props as {
  alternativesIndex: CollectionEntry<"alternatives">;
  alternatives: CollectionEntry<"alternatives">[];
  lang: string;
  alternativeLinkLang?: string;
};
const { alternativeLinkLang } = Astro.props as { alternativeLinkLang?: string };
const isPolish = lang === "pl";

const copy = isPolish
  ? {
      eyebrow: "Niezależne przewodniki porównawcze",
      primaryAction: "Przeglądaj porównania",
      secondaryAction: "Sprawdź swoją markę",
      latestGuide: "Najnowszy przewodnik",
      sectionTitle: "Znajdź właściwą platformę do widoczności w AI",
      sectionDescription:
        "Porównuj narzędzia pod kątem monitoringu marki, śledzenia promptów, cytowań, dokładności odpowiedzi, raportowania i możliwości zamiany wyników w konkretne działania.",
      readComparison: "Przeczytaj porównanie",
    }
  : {
      eyebrow: "Independent comparison guides",
      primaryAction: "Browse comparisons",
      secondaryAction: "Scan your brand",
      latestGuide: "Latest guide",
      sectionTitle: "Find the right AI visibility platform",
      sectionDescription:
        "Compare tools by brand monitoring depth, prompt tracking, citations, answer accuracy, reporting, and the ability to turn findings into action.",
      readComparison: "Read the comparison",
    };

const localizedAlternatives: Record<
  string,
  { title: string; description: string; categories: string[] }
> = {
  "best-ai-visibility-tools": {
    title: "7 najlepszych narzędzi do widoczności marki w AI w 2026",
    description:
      "Porównaj wiodące narzędzia do monitorowania wzmiankowania marki, AI Share of Voice, widoczności konkurencji, cytowań, sentymentu i dokładności odpowiedzi.",
    categories: ["Narzędzia do widoczności w AI", "Alternatywy"],
  },
};

const getAlternativeSlug = (alternative: CollectionEntry<"alternatives">) =>
  stripLocaleFromId(alternative.id);
const getAlternativeCopy = (alternative: CollectionEntry<"alternatives">) => {
  const slug = getAlternativeSlug(alternative);
  const localized = isPolish ? localizedAlternatives[slug] : undefined;

  return {
    title: localized?.title || alternative.data.title,
    description: localized?.description || plainify(alternative.data.description),
    categories: localized?.categories || alternative.data.categories.map((category) => humanize(category)),
  };
};
---

<AIBrandScanArchiveHero
  eyebrow={copy.eyebrow}
  title={alternativesIndex.data.title}
  description={alternativesIndex.data.description}
  primaryAction={{ label: copy.primaryAction, href: "#comparison-guides" }}
  secondaryAction={{ label: copy.secondaryAction, href: "https://aibrandscan.com/register" }}
/>

<section id="comparison-guides" class="section scroll-mt-24">
  <div class="container">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">{copy.latestGuide}</p>
        <h2 class="h2 mb-4">{copy.sectionTitle}</h2>
        <p class="mb-0 text-lg leading-8">
          {copy.sectionDescription}
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        {alternatives.map((alternative) => {
          const slug = getAlternativeSlug(alternative);
          const alternativeCopy = getAlternativeCopy(alternative);

          return (
            <article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-border bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-darkmode-border dark:bg-darkmode-light md:p-9">
              <div class="mb-5 flex flex-wrap gap-2">
                {alternativeCopy.categories.map((category: string) => (
                  <span class="rounded-full border border-orange-100 bg-[#fbfaf8] px-3 py-1 text-xs font-bold text-slate-950 dark:border-orange-900/50 dark:bg-orange-950/20 dark:text-orange-100">
                    {category}
                  </span>
                ))}
              </div>
              <h3 class="h3 mb-4">
                <a class="transition hover:text-orange-600 dark:hover:text-orange-300" href={alternativePath(slug, alternativeLinkLang)}>
                  {alternativeCopy.title}
                </a>
              </h3>
              <p class="mb-7 text-base leading-7">{alternativeCopy.description}</p>
              <a
                class="aibrandscan-button aibrandscan-button-primary aibrandscan-button-sm mt-auto self-start"
                href={alternativePath(slug, alternativeLinkLang)}
              >
                {copy.readComparison}
                <FaArrowRight className="transition group-hover:translate-x-1" />
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>
