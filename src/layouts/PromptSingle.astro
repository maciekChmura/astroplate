---
import TableOfContents from "@/components/TableOfContents.astro";
import { getTranslations } from "@/lib/utils/languageParser";
import { humanize, markdownify } from "@/lib/utils/textConverter";
import PromptVisual from "./components/PromptVisual.astro";
import { render } from "astro:content";
import { FaRegFolder, FaRegUser } from "react-icons/fa";

const { promptEntry, lang, author } = Astro.props;
const { Content, headings } = await render(promptEntry);
const {
  title,
  description,
  image,
  categories,
  tags,
  what_it_does,
  best_input,
  prompt,
} = promptEntry.data;
const translations = (await getTranslations(lang)) as Record<string, string>;
const copyLabel = translations.copy_prompt || "Copy prompt";
const copiedLabel = translations.copied_prompt || "Copied";
const promptLabel = translations.prompt || "Prompt";
const tableOfContents = translations.table_of_contents || "Table of contents";
const hasStructuredSections = Boolean(what_it_does || best_input);
const promptHeadings = hasStructuredSections
  ? [
      what_it_does && {
        depth: 2,
        slug: "what-it-does",
        text: "What it does",
      },
      { depth: 2, slug: "prompt", text: promptLabel },
      best_input && { depth: 2, slug: "best-input", text: "Best input" },
    ].filter(Boolean)
  : [{ depth: 2, slug: "prompt", text: promptLabel }, ...headings];
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-10">
        {
          image && (
            <div class="mb-10">
              <PromptVisual
                src={image}
                height={500}
                width={1200}
                alt={title}
                seed={title}
                class="w-full rounded"
                format="webp"
              />
            </div>
          )
        }
        <h1 set:html={markdownify(title)} class="h2 mb-4" />
        <p class="mb-6 text-lg">{description}</p>
        <ul class="mb-8">
          <li class="mr-4 inline-block">
            <FaRegUser className={"mr-2 -mt-1 inline-block"} />
            {
              author?.url ? (
                <a href={author.url}>{author.name}</a>
              ) : (
                <span>{author?.name}</span>
              )
            }
          </li>
          <li class="mr-4 inline-block">
            <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
            {
              categories.map((category: string, index: number) => (
                <span>
                  {humanize(category)}
                  {index !== categories.length - 1 && ", "}
                </span>
              ))
            }
          </li>
        </ul>

        <TableOfContents headings={promptHeadings} title={tableOfContents} />

        {
          hasStructuredSections && what_it_does && (
            <section class="content mb-10">
              <h2 id="what-it-does">What it does</h2>
              <div set:html={markdownify(what_it_does, true)} />
            </section>
          )
        }

        <div
          class="mb-10 rounded bg-light p-6 dark:bg-darkmode-light"
          data-prompt-container
        >
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <h2 id="prompt" class="h5 mb-0">{promptLabel}</h2>
            <button
              class="btn btn-outline-primary btn-sm"
              type="button"
              data-copy-prompt
              data-copy-label={copyLabel}
              data-copied-label={copiedLabel}
            >
              {copyLabel}
            </button>
          </div>
          <pre
            class="whitespace-pre-wrap break-words rounded bg-body p-5 text-sm leading-7 dark:bg-darkmode-body"><code data-prompt-text>{prompt}</code></pre>
        </div>

        {
          hasStructuredSections ? (
            best_input && (
              <section class="content mb-10">
                <h2 id="best-input">Best input</h2>
                <div set:html={markdownify(best_input, true)} />
              </section>
            )
          ) : (
            <div class="content mb-10">
              <Content />
            </div>
          )
        }
        <div class="flex flex-wrap items-center gap-2">
          {
            tags.map((tag: string) => (
              <span class="rounded bg-light px-3 py-1 text-sm dark:bg-darkmode-light">
                {humanize(tag)}
              </span>
            ))
          }
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const copyButtons = document.querySelectorAll("[data-copy-prompt]");

  copyButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const container = button.closest("[data-prompt-container]");
      const promptText = container?.querySelector("[data-prompt-text]");
      const text = promptText?.textContent || "";
      const originalLabel = button.getAttribute("data-copy-label") || "";
      const copiedLabel = button.getAttribute("data-copied-label") || "";

      const fallbackCopy = () => {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.top = "-9999px";
        document.body.appendChild(textarea);
        textarea.select();
        const copied = document.execCommand("copy");
        textarea.remove();
        return copied;
      };

      try {
        if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            fallbackCopy();
          }
        } else {
          fallbackCopy();
        }

        button.textContent = copiedLabel;
        setTimeout(() => {
          button.textContent = originalLabel;
        }, 2000);
      } catch {
        button.textContent = originalLabel;
      }
    });
  });
</script>
