---
import BeforeAfter from "@/components/BeforeAfter.astro";
import { siteConfig } from "@/lib/siteConfig";
import { getTranslations, slugSelector } from "@/lib/utils/languageParser";
import { humanize, markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import { FaRegFolder, FaRegUser } from "react-icons/fa";
import ImageMod from "./components/ImageMod.astro";

type UseCaseImage = {
  src: string;
  alt: string;
  caption?: string;
};

type UseCaseTextImage = {
  title: string;
  description?: string;
  image?: UseCaseImage;
};

type UseCaseInputExample = UseCaseTextImage & {
  accepted_formats?: string[];
};

type UseCaseStyle = {
  title: string;
  description?: string;
  image?: UseCaseImage;
};

type UseCaseStyleSelection = UseCaseTextImage & {
  styles?: UseCaseStyle[];
};

type UseCaseWorkflowStep = UseCaseTextImage & {
  accepted_formats?: string[];
  styles?: UseCaseStyle[];
  fallbackImage?: string;
  fallbackAlt?: string;
};

type UseCaseVideo = {
  title: string;
  embed_url: string;
  caption?: string;
};

type UseCaseFaq = {
  question: string;
  answer: string;
};

const { useCaseEntry, lang, author } = Astro.props;
const { Content } = await render(useCaseEntry);
const {
  title,
  description,
  image,
  categories,
  tags,
  software,
  workflow,
  rendering_intent,
  input_example,
  style_selection,
  result,
  video,
  hero_before,
  hero_after,
  steps,
  preserved,
  faq,
  cta,
} = useCaseEntry.data;
const translations = (await getTranslations(lang)) as Record<string, string>;
const productName = siteConfig.site.title;
const withProductName = (value: string) =>
  value.replaceAll("QuickArchViz", productName);
const beforeLabel = translations.input || "Input";
const afterLabel = withProductName(
  translations.quickarchviz_result || "QuickArchViz Result",
);
const howItWorksLabel = translations.use_case_how_it_works || "How It Works";
const stepLabel = translations.use_case_step || "Step";
const comparisonLabel = translations.use_case_comparison || "Before and After";
const preservesLabel = withProductName(
  translations.use_case_preserves || "What QuickArchViz Preserves",
);
const faqLabel = translations.use_case_faq || "FAQ";
const formatLabel =
  translations.use_case_accepted_formats || "Accepted formats";
const styleSelectionFallbackTitle =
  translations.use_case_style_selection || "Styles to Pick";

const inputSection = input_example as UseCaseInputExample | undefined;
const acceptedFormats = inputSection?.accepted_formats || [];
const resultSection =
  (result as UseCaseTextImage | undefined) ||
  (hero_after && {
    title: afterLabel,
    description: hero_after.caption,
    image: hero_after,
  });
const styleSelection = style_selection as UseCaseStyleSelection | undefined;
const styles = (styleSelection?.styles || steps || []) as UseCaseStyle[];
const styleTitle = style_selection?.title || styleSelectionFallbackTitle;
const workflowSteps = [
  inputSection && {
    ...inputSection,
    accepted_formats: acceptedFormats,
    fallbackImage: image,
    fallbackAlt: title,
  },
  (styleSelection || styles.length > 0) && {
    title: styleTitle,
    description: styleSelection?.description,
    image: styleSelection?.image,
    styles: styleSelection?.image ? [] : styles,
  },
  resultSection && {
    ...resultSection,
    fallbackImage: image,
    fallbackAlt: title,
  },
].filter(Boolean) as UseCaseWorkflowStep[];
const badges = [software, workflow, rendering_intent].filter(Boolean);
const showMeta = Boolean(author?.name || categories.length > 0);

function isBunnyEmbedUrl(embedUrl?: string) {
  return Boolean(
    embedUrl &&
    /^https:\/\/(player|iframe)\.mediadelivery\.net\//.test(embedUrl),
  );
}

const videoEmbedUrl = isBunnyEmbedUrl(video?.embed_url)
  ? video.embed_url
  : undefined;
const hasBodyContent = Boolean(useCaseEntry.body?.trim());

function emphasizeProductTerms(content: string) {
  return content.replaceAll("Advanced Mode", "**Advanced Mode**");
}
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-10">
        <header class="mb-14 max-w-4xl">
          {
            badges.length > 0 && (
              <div class="mb-6 flex flex-wrap gap-2">
                {badges.map((item: string) => (
                  <span class="rounded bg-light px-3 py-1 text-sm font-medium text-text-dark dark:bg-darkmode-light dark:text-darkmode-text">
                    {item}
                  </span>
                ))}
              </div>
            )
          }
          <h1 set:html={markdownify(title)} class="h1 mb-5" />
          <p
            class="mb-6 text-lg leading-8 text-text dark:text-darkmode-text"
            set:html={markdownify(emphasizeProductTerms(description))}
          />
          {
            showMeta && (
              <ul class="mb-0 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                {author?.name && (
                  <li>
                    <FaRegUser className={"mr-2 -mt-1 inline-block"} />
                    {author?.url ? (
                      <a href={author.url}>{author.name}</a>
                    ) : (
                      <span>{author.name}</span>
                    )}
                  </li>
                )}
                {categories.length > 0 && (
                  <li>
                    <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
                    {categories.map((category: string, index: number) => (
                      <span>
                        {humanize(category)}
                        {index !== categories.length - 1 && ", "}
                      </span>
                    ))}
                  </li>
                )}
              </ul>
            )
          }
        </header>

        {
          workflowSteps.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-8 text-center">{howItWorksLabel}</h2>
              <div class="grid gap-10">
                {workflowSteps.map((step: UseCaseWorkflowStep, index: number) => (
                  <article class="grid items-center gap-8 border-b border-border pb-10 last:border-b-0 last:pb-0 md:grid-cols-2 dark:border-darkmode-border">
                    <div>
                      {step.image ? (
                        <figure class="overflow-hidden rounded bg-light dark:bg-darkmode-light">
                          <ImageMod
                            src={step.image.src}
                            alt={step.image.alt}
                            width={900}
                            height={600}
                            loading={index === 0 ? "eager" : undefined}
                            decoding={index === 0 ? "async" : undefined}
                            fit="cover"
                            class="aspect-[3/2] w-full object-cover"
                            format="webp"
                          />
                          {step.image.caption && (
                            <figcaption class="px-4 py-3 text-sm">
                              {step.image.caption}
                            </figcaption>
                          )}
                        </figure>
                      ) : step.styles && step.styles.length > 0 ? (
                        <div class="grid gap-4 sm:grid-cols-2">
                          {step.styles.map((style: UseCaseStyle) => (
                            <div>
                              {style.image && (
                                <figure class="relative overflow-hidden rounded border border-transparent bg-light shadow transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg dark:bg-darkmode-light">
                                  <ImageMod
                                    src={style.image.src}
                                    alt={style.image.alt}
                                    width={600}
                                    height={600}
                                    fit="cover"
                                    class="aspect-square w-full object-cover"
                                    format="webp"
                                  />
                                  <figcaption class="absolute inset-x-4 bottom-5 flex justify-center">
                                    <span class="rounded-full bg-white/95 px-4 py-1.5 text-center font-secondary text-sm font-medium leading-none text-text-dark shadow">
                                      {style.title}
                                    </span>
                                  </figcaption>
                                </figure>
                              )}
                              {!style.image && (
                                <div class="rounded bg-light p-5 dark:bg-darkmode-light">
                                  <h3 class="h5 mb-0">{style.title}</h3>
                                </div>
                              )}
                            </div>
                          ))}
                        </div>
                      ) : (
                        step.fallbackImage && (
                          <ImageMod
                            src={step.fallbackImage}
                            height={600}
                            width={900}
                            alt={step.fallbackAlt || step.title}
                            class="aspect-[3/2] w-full rounded object-cover"
                            format="webp"
                          />
                        )
                      )}
                    </div>
                    <div class="md:pl-8">
                      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.16em] text-primary">
                        {stepLabel} {index + 1}
                      </p>
                      <h3 class="h3 mb-4">{step.title}</h3>
                      {step.description && (
                        <div
                          class="content mb-5"
                          set:html={markdownify(
                            emphasizeProductTerms(step.description),
                            true,
                          )}
                        />
                      )}
                      {step.accepted_formats && step.accepted_formats.length > 0 && (
                        <div>
                          <p class="mb-3 text-sm font-semibold uppercase text-text-dark dark:text-darkmode-text">
                            {formatLabel}
                          </p>
                          <div class="flex flex-wrap gap-2">
                            {step.accepted_formats.map((format: string) => (
                              <span class="rounded bg-light px-3 py-1 text-sm dark:bg-darkmode-light">
                                {format}
                              </span>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        {
          videoEmbedUrl && (
            <section class="mb-16">
              <h2 class="h3 mb-6">{(video as UseCaseVideo).title}</h2>
              <div class="overflow-hidden rounded bg-light dark:bg-darkmode-light">
                <div class="relative aspect-video w-full">
                  <iframe
                    src={videoEmbedUrl}
                    title={(video as UseCaseVideo).title}
                    loading="lazy"
                    class="absolute inset-0 h-full w-full border-0"
                    allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
                    allowfullscreen
                  />
                </div>
                {(video as UseCaseVideo).caption && (
                  <p class="mb-0 px-4 py-3 text-sm">
                    {(video as UseCaseVideo).caption}
                  </p>
                )}
              </div>
            </section>
          )
        }

        {
          hero_before && hero_after && (
            <section class="mb-16">
              <h2 class="h3 mb-6">{comparisonLabel}</h2>
              <BeforeAfter
                before={hero_before}
                after={hero_after}
                beforeLabel={beforeLabel}
                afterLabel={afterLabel}
              />
            </section>
          )
        }

        {
          preserved.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-6 text-center">{preservesLabel}</h2>
              <div class="grid gap-3 sm:grid-cols-2">
                {preserved.map((item: string) => (
                  <div class="rounded bg-[#f6efe4] px-4 py-4 text-center font-bold text-[#3a332a] ring-1 ring-[#eadfce] dark:bg-[#3a332a]/30 dark:text-[#f6efe4] dark:ring-[#eadfce]/20">
                    {item}
                  </div>
                ))}
              </div>
            </section>
          )
        }

        {
          hasBodyContent && (
            <div class="content mb-16">
              <Content />
            </div>
          )
        }

        {
          faq.length > 0 && (
            <section class="mb-16">
              <h2 class="h3 mb-6">{faqLabel}</h2>
              <div class="grid gap-4">
                {faq.map((item: UseCaseFaq) => (
                  <details class="rounded bg-light p-5 dark:bg-darkmode-light">
                    <summary class="cursor-pointer font-secondary text-lg font-semibold text-text-dark dark:text-darkmode-text">
                      {item.question}
                    </summary>
                    <p
                      class="mb-0 mt-4"
                      set:html={markdownify(item.answer)}
                    />
                  </details>
                ))}
              </div>
            </section>
          )
        }

        {
          cta?.enable && (
            <section class="mb-10 rounded bg-gradient-to-br from-[#f8f1e7] via-[#efe2d0] to-[#d9c1a2] p-8 text-center text-[#3a332a] shadow-sm ring-1 ring-[#eadfce]">
              {cta.title && (
                <h2 class="h3 mb-4 text-[#3a332a]">{cta.title}</h2>
              )}
              {cta.description && (
                <p class="mx-auto mb-6 max-w-2xl text-[#5a5044]">
                  {cta.description}
                </p>
              )}
              <a
                class="btn border-[#3a332a] bg-[#3a332a] text-[#f8f1e7] hover:border-[#2a241e] hover:bg-[#2a241e] hover:text-white"
                href={slugSelector(cta.link, lang)}
              >
                {cta.label}
              </a>
            </section>
          )
        }

        {
          tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              {tags.map((tag: string) => (
                <span class="rounded bg-light px-3 py-1 text-sm dark:bg-darkmode-light">
                  {humanize(tag)}
                </span>
              ))}
            </div>
          )
        }
      </article>
    </div>
  </div>
</section>
