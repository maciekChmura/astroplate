---
import { promptPath } from "@/lib/utils/promptRoutes";
import {
  getAIBrandScanPromptCopy,
  getAIBrandScanPromptSlug,
} from "@/lib/utils/aibrandscanPromptCopy";
import AIBrandScanArchiveHero from "@/components/AIBrandScanArchiveHero.astro";
import {
  FaArrowRight,
  FaChartLine,
  FaCodeCompare,
  FaFileLines,
  FaMagnifyingGlassChart,
  FaRobot,
} from "react-icons/fa6";

const { promptIndex, prompts, lang, promptLinkLang } = Astro.props;
const isPolish = lang === "pl";

const categoryOrder = [
  "Diagnose AI Visibility",
  "Compare Against Competitors",
  "Build AI-Friendly Content",
  "Buyer Research",
  "Monitor and Report",
];

const promptOrder = [
  "ai-brand-visibility-audit-prompt",
  "why-chatgpt-is-not-mentioning-my-brand",
  "ai-competitor-visibility-gap-prompt",
  "ai-share-of-voice-tracking-prompt",
  "ai-buyer-intent-prompt-generator",
  "ai-answer-accuracy-evaluation-prompt",
  "ai-content-gap-analysis-prompt",
  "geo-content-roadmap-prompt",
  "ai-friendly-faq-prompt",
  "ai-brand-entity-profile-prompt",
  "competitor-alternatives-page-brief",
  "ai-reputation-risk-scanner",
  "ceo-ai-visibility-summary-prompt",
  "ai-visibility-audit-proposal-template",
  "monthly-ai-visibility-monitoring-pack",
];

const promptRank = new Map(
  promptOrder.map((slug, index) => [slug, index + 1]),
);

const categoryDescriptions: Record<string, string> = {
  "Diagnose AI Visibility":
    "Understand whether AI assistants know, mention, describe, and recommend your brand correctly.",
  "Compare Against Competitors":
    "Find out why competitors appear more often and where their evidence or content is stronger.",
  "Build AI-Friendly Content":
    "Create clearer pages, FAQs, entity information, and publishing plans for AI search.",
  "Buyer Research":
    "Discover the real questions buyers may ask AI before choosing a vendor or product.",
  "Monitor and Report":
    "Turn visibility data into recurring reports, leadership summaries, and client deliverables.",
};

const categoryLabels: Record<string, string> = isPolish
  ? {
      "Diagnose AI Visibility": "Diagnoza widoczności w AI",
      "Compare Against Competitors": "Porównanie z konkurencją",
      "Build AI-Friendly Content": "Treści przyjazne AI",
      "Buyer Research": "Research pytań kupujących",
      "Monitor and Report": "Monitoring i raporty",
    }
  : Object.fromEntries(categoryOrder.map((category) => [category, category]));

const localizedCategoryDescriptions: Record<string, string> = isPolish
  ? {
      "Diagnose AI Visibility":
        "Sprawdź, czy asystenci AI znają, wspominają, opisują i rekomendują Twoją markę poprawnie.",
      "Compare Against Competitors":
        "Zobacz, dlaczego konkurenci pojawiają się częściej i gdzie ich treści lub dowody są silniejsze.",
      "Build AI-Friendly Content":
        "Twórz jaśniejsze strony, FAQ, informacje o encji marki i plany publikacji pod AI search.",
      "Buyer Research":
        "Odkryj realne pytania, które kupujący mogą zadawać AI przed wyborem dostawcy lub produktu.",
      "Monitor and Report":
        "Zamieniaj dane o widoczności w cykliczne raporty, podsumowania dla liderów i materiały dla klientów.",
    }
  : categoryDescriptions;

const categoryIcons: Record<string, any> = {
  "Diagnose AI Visibility": FaMagnifyingGlassChart,
  "Compare Against Competitors": FaCodeCompare,
  "Build AI-Friendly Content": FaFileLines,
  "Buyer Research": FaRobot,
  "Monitor and Report": FaChartLine,
};

const getCategoryId = (category: string) =>
  `prompt-${category
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "")}`;

const groupedPrompts = categoryOrder
  .map((category) => ({
    category,
    id: getCategoryId(category),
    prompts: prompts.filter(
      (entry: any) => entry.data.library_category === category,
    ).sort((a: any, b: any) => {
      const slugA = a.id.split("/").pop();
      const slugB = b.id.split("/").pop();
      return (
        (promptRank.get(slugA) || Number.MAX_SAFE_INTEGER) -
        (promptRank.get(slugB) || Number.MAX_SAFE_INTEGER)
      );
    }),
  }))
  .filter((group) => group.prompts.length > 0);
const totalPrompts = groupedPrompts.reduce(
  (total, group) => total + group.prompts.length,
  0,
);

const copy = isPolish
  ? {
      heroEyebrow: "15 zaawansowanych promptów, 5 praktycznych procesów",
      heroTitle: promptIndex?.data?.title || "Biblioteka promptów AI Visibility",
      heroDescription:
        promptIndex?.data?.description ||
        "Diagnozuj, monitoruj i poprawiaj to, jak ChatGPT, Claude, Gemini, Perplexity, Copilot i Google AI Overviews rozumieją, porównują i rekomendują Twoją markę.",
      primaryAction: "Przeglądaj bibliotekę",
      secondaryAction: "Automatyzuj monitoring marki",
      howLabel: "Jak korzystać z biblioteki",
      howTitle: "Zacznij od pytania biznesowego, potem wybierz właściwy prompt",
      howDescription:
        "Każdy prompt zawiera zastosowanie, wymagane dane wejściowe, oczekiwane wyniki, pełny zaawansowany prompt i rekomendowany następny krok.",
      steps: [
        ["1", "Wybierz proces", "Zacznij od pytania biznesowego, na które chcesz odpowiedzieć."],
        ["2", "Przygotuj dane wejściowe", "Użyj zweryfikowanych faktów o marce, konkurentów, zapytań i odpowiedzi AI."],
        ["3", "Uruchom prompt", "Przetestuj go ręcznie w kilku asystentach AI i zapisz dowody."],
        ["4", "Monitoruj zmianę", "Powtarzaj ważne zapytania albo automatyzuj monitoring w AI Brand Scan."],
      ],
      categoriesLabel: "Kategorie promptów",
      categoriesTitle: "Wybierz rezultat, którego potrzebujesz",
      categoriesDescription:
        "Zacznij od diagnozy, porównania, treści, researchu kupujących albo raportowania. Każdy prompt działa jak profesjonalny materiał roboczy.",
      allPrompts: "Wszystkie prompty",
      useCase: "Zastosowanie",
      bestFor: "Najlepsze dla",
      openPrompt: "Otwórz prompt",
      ctaTitle: "Chcesz monitorować to automatycznie?",
      ctaDescription:
        "Ręczne testowanie promptów pomaga w diagnozie, ale trudno je powtarzać, porównywać i raportować spójnie. AI Brand Scan zamienia jednorazowe testy promptów w powtarzalny system monitorowania widoczności w AI.",
      ctaLabel: "Uruchom AI Brand Scan",
    }
  : {
      heroEyebrow: "15 advanced prompts, 5 practical workflows",
      heroTitle: "AI Visibility Prompt Library",
      heroDescription:
        "Diagnose, monitor, and improve how ChatGPT, Claude, Gemini, Perplexity, Copilot, and Google AI Overviews understand, compare, and recommend your brand.",
      primaryAction: "Browse the library",
      secondaryAction: "Automate brand monitoring",
      howLabel: "How to use this library",
      howTitle: "Start with a business question, then choose the right prompt",
      howDescription:
        "Each prompt includes the use case, required inputs, expected outputs, full Advanced Prompt, and the recommended next action.",
      steps: [
        ["1", "Choose a workflow", "Start with the business question you need to answer."],
        ["2", "Prepare inputs", "Use verified brand facts, competitors, queries, and AI answers."],
        ["3", "Run the prompt", "Test manually across several AI assistants and save the evidence."],
        ["4", "Monitor change", "Repeat important queries or automate tracking with AI Brand Scan."],
      ],
      categoriesLabel: "Prompt categories",
      categoriesTitle: "Choose the outcome you need",
      categoriesDescription:
        "Start with diagnosis, comparison, content, buyer research, or reporting. Each prompt is built as a professional working asset.",
      allPrompts: "All prompts",
      useCase: "Use case",
      bestFor: "Best for",
      openPrompt: "Open prompt",
      ctaTitle: "Want to monitor this automatically?",
      ctaDescription:
        "Manual prompt testing is useful for investigation, but difficult to repeat, compare, and report consistently. AI Brand Scan turns one-time prompt checks into a repeatable AI visibility monitoring system.",
      ctaLabel: "Run your AI Brand Scan",
    };

const getPromptSlug = getAIBrandScanPromptSlug;
const getPromptCopy = (entry: any) => getAIBrandScanPromptCopy(entry, lang);
const promptCountLabel = (count: number) => {
  if (!isPolish) {
    return `${count} prompts`;
  }

  if (count === 1) {
    return "1 prompt";
  }

  if (count >= 2 && count <= 4) {
    return `${count} prompty`;
  }

  return `${count} promptów`;
};
---

<div class="overflow-hidden bg-body dark:bg-darkmode-body">
  <AIBrandScanArchiveHero
    eyebrow={copy.heroEyebrow}
    title={copy.heroTitle}
    description={copy.heroDescription}
    primaryAction={{ label: copy.primaryAction, href: "#prompt-categories" }}
    secondaryAction={{ label: copy.secondaryAction, href: "https://aibrandscan.com" }}
  />

  <section class="border-y border-slate-200 bg-[#fbfaf8] py-12 dark:border-darkmode-border dark:bg-darkmode-light">
    <div class="container">
      <div class="mb-10 max-w-3xl">
        <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-orange-600 dark:text-orange-300">
          {copy.howLabel}
        </span>
        <h2 class="h2 mb-4">{copy.howTitle}</h2>
        <p class="mb-0 text-lg leading-8">
          {copy.howDescription}
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {copy.steps.map(([number, title, description]) => (
          <article>
            <div class="mb-4 flex items-center gap-2 font-mono text-sm font-bold uppercase tracking-[0.2em]">
              <span class="text-slate-300">[</span>
              <span class="text-orange-600">{String(number).padStart(2, "0")}</span>
              <span class="text-slate-300">]</span>
            </div>
            <h3 class="mb-2 text-lg font-extrabold tracking-[-0.01em] text-slate-950 dark:text-darkmode-text-dark">{title}</h3>
            <p class="mb-0 text-sm leading-6 text-slate-600 dark:text-darkmode-text">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="prompt-categories" class="section-sm scroll-mt-24">
    <div class="container">
      <div class="mb-12 max-w-3xl">
        <span class="mb-3 block text-sm font-bold uppercase tracking-[.18em] text-orange-600 dark:text-orange-300">
          {copy.categoriesLabel}
        </span>
        <h2 class="h2 mb-4">{copy.categoriesTitle}</h2>
        <p class="text-lg leading-8">
          {copy.categoriesDescription}
        </p>
      </div>

      <div class="sticky top-[72px] z-20 -mx-4 mb-12 overflow-x-auto bg-white/90 px-4 py-3 backdrop-blur dark:bg-darkmode-body/90">
        <nav
          class="mx-auto flex min-w-max w-fit items-center gap-1 rounded-[1.5rem] bg-[#f1eee7] p-2 dark:bg-darkmode-light"
          aria-label="Prompt library sections"
          data-prompt-tabs
        >
          <button
            type="button"
            class="rounded-[1.15rem] px-5 py-3 text-sm font-semibold text-slate-500 no-underline transition hover:bg-white/70 hover:text-slate-950 data-[active=true]:bg-white data-[active=true]:text-slate-950 data-[active=true]:shadow-sm dark:text-darkmode-text dark:hover:bg-darkmode-body dark:hover:text-white data-[active=true]:dark:bg-darkmode-body data-[active=true]:dark:text-white"
            data-prompt-filter="all"
            data-active="true"
            aria-pressed="true"
          >
            {copy.allPrompts} ({totalPrompts})
          </button>
          {groupedPrompts.map((group) => (
            <button
              type="button"
              class="rounded-[1.15rem] px-5 py-3 text-sm font-semibold text-slate-500 no-underline transition hover:bg-white/70 hover:text-slate-950 data-[active=true]:bg-white data-[active=true]:text-slate-950 data-[active=true]:shadow-sm dark:text-darkmode-text dark:hover:bg-darkmode-body dark:hover:text-white data-[active=true]:dark:bg-darkmode-body data-[active=true]:dark:text-white"
              data-prompt-filter={group.id}
              data-active="false"
              aria-pressed="false"
            >
              {categoryLabels[group.category]} ({group.prompts.length})
            </button>
          ))}
        </nav>
      </div>

      <div class="space-y-16" data-prompt-groups>
        {groupedPrompts.map((group) => {
          const Icon = categoryIcons[group.category];
          return (
            <section id={group.id} class="scroll-mt-36" data-prompt-group={group.id}>
              <div class="mb-7 overflow-hidden rounded-[1.75rem] border border-slate-200 bg-[#fbfaf8] shadow-sm dark:border-darkmode-border dark:bg-darkmode-light">
                <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
                <div>
                  <div class="mb-3 flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-orange-600 shadow-sm dark:bg-darkmode-body dark:text-orange-300">
                      <Icon />
                    </div>
                    <h3 class="h3 mb-0">{categoryLabels[group.category]}</h3>
                  </div>
                  <p class="mb-0 max-w-3xl leading-7">
                    {localizedCategoryDescriptions[group.category]}
                  </p>
                </div>
                  <span class="w-fit rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-950 dark:border-darkmode-border dark:bg-darkmode-body dark:text-white">
                    {promptCountLabel(group.prompts.length)}
                  </span>
                </div>
              </div>

              <div class="grid gap-5 2xl:grid-cols-2">
                {group.prompts.map((entry: any, index: number) => {
                  const promptCopy = getPromptCopy(entry);
                  const promptSlug = getPromptSlug(entry);

                  return (
                  <article class="group flex h-full flex-col rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-[0_10px_30px_rgba(15,23,42,0.06)] transition duration-300 hover:-translate-y-1 hover:border-orange-300 hover:shadow-[0_18px_45px_rgba(15,23,42,0.1)] dark:border-darkmode-border dark:bg-darkmode-body dark:hover:border-orange-700 sm:p-6">
                    <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                      <div class="flex min-w-0 items-start gap-4">
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-orange-50 text-base font-black text-slate-950 dark:bg-orange-950/40 dark:text-white">
                          {String(
                            promptRank.get(promptSlug) ||
                              index + 1,
                          ).padStart(2, "0")}
                        </span>
                        <div class="min-w-0 pt-2">
                          <h4 class="mb-0 text-xl font-extrabold leading-tight tracking-[-0.02em] text-slate-950 dark:text-darkmode-text-dark">
                            <a
                              class="transition group-hover:text-orange-600 dark:group-hover:text-orange-300"
                              href={promptPath(promptSlug, promptLinkLang)}
                            >
                              {promptCopy.title}
                            </a>
                          </h4>
                        </div>
                      </div>
                    </div>

                    <div class="grow rounded-2xl border border-slate-200 bg-[#fbfaf8] p-5 dark:border-darkmode-border dark:bg-darkmode-light/70">
                      <p class="mb-2 text-xs font-black uppercase tracking-wider text-orange-600 dark:text-orange-300">
                        {copy.useCase}
                      </p>
                      <p class="mb-0 text-lg leading-8 text-slate-950 dark:text-darkmode-text-dark">
                        {promptCopy.useCase}
                      </p>
                    </div>

                    <div class="mt-4 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
                      <div class="max-w-2xl">
                        <p class="mb-2 text-xs font-black uppercase tracking-wider text-text-light dark:text-darkmode-text-light">
                          {copy.bestFor}
                        </p>
                        <p class="mb-0 text-sm leading-6 text-text-light dark:text-darkmode-text-light">
                          {promptCopy.bestFor}
                        </p>
                      </div>
                      <a
                        class="aibrandscan-button aibrandscan-button-primary aibrandscan-button-sm shrink-0 self-start sm:self-end"
                        href={promptPath(promptSlug, promptLinkLang)}
                      >
                        {copy.openPrompt}
                        <FaArrowRight className="transition group-hover:translate-x-1" />
                      </a>
                    </div>
                  </article>
                )})}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container">
      <div class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-[#fbfaf8] px-6 py-14 text-center text-slate-950 shadow-[0_18px_50px_rgba(15,23,42,0.08)] sm:px-12 dark:border-darkmode-border dark:bg-darkmode-light dark:text-white">
        <div class="absolute inset-0 opacity-[0.5] [background-image:linear-gradient(to_right,#1118270a_1px,transparent_1px),linear-gradient(to_bottom,#1118270a_1px,transparent_1px)] [background-size:42px_42px] dark:opacity-[0.08]"></div>
        <div class="relative mx-auto max-w-3xl">
          <h2 class="mb-5 text-3xl font-bold text-slate-950 sm:text-4xl dark:text-white">
            {copy.ctaTitle}
          </h2>
          <p class="mx-auto mb-8 max-w-2xl text-lg leading-8 text-slate-700 dark:text-slate-200">
            {copy.ctaDescription}
          </p>
          <a class="aibrandscan-button aibrandscan-button-primary" href="https://aibrandscan.com">
            {copy.ctaLabel} <FaArrowRight />
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  const promptTabs = document.querySelector("[data-prompt-tabs]");
  const promptGroups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-prompt-group]"),
  );
  const promptButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-prompt-filter]"),
  );

  const setPromptFilter = (filter: string, options?: { updateHash?: boolean }) => {
    const activeFilter = filter === "all" ? "all" : filter;

    promptButtons.forEach((button) => {
      const isActive = button.dataset.promptFilter === activeFilter;
      button.dataset.active = String(isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });

    promptGroups.forEach((group) => {
      const shouldShow =
        activeFilter === "all" || group.dataset.promptGroup === activeFilter;
      group.hidden = !shouldShow;
    });

    if (options?.updateHash) {
      const nextHash = activeFilter === "all" ? "#prompt-categories" : `#${activeFilter}`;
      history.replaceState(null, "", nextHash);
    }
  };

  promptTabs?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>("[data-prompt-filter]");

    if (!button) {
      return;
    }

    setPromptFilter(button.dataset.promptFilter || "all", { updateHash: true });
  });

  const initialHash = window.location.hash.replace("#", "");
  const hasMatchingGroup = promptGroups.some(
    (group) => group.dataset.promptGroup === initialHash,
  );

  setPromptFilter(hasMatchingGroup ? initialHash : "all");
</script>
