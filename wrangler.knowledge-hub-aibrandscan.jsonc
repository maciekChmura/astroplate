{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aibrandscan-knowledge-hub-proxy",
  "main": "workers/knowledgeHubAIBrandScanProxy.js",
  "compatibility_date": "2026-05-12",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "aibrandscan.com/knowledge-hub",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/knowledge-hub/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/knowledge-hub-assets/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/blog",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/blog/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/prompts",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/prompts/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/alternatives",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/alternatives/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/for",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/for/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/use-cases",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/use-cases/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/authors",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/authors/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/categories",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/categories/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/tags",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/tags/*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/privacy-policy",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/sitemap*",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/llms.txt",
      "zone_name": "aibrandscan.com",
    },
    {
      "pattern": "aibrandscan.com/llms-full.txt",
      "zone_name": "aibrandscan.com",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
